# ===== deepseek-harness-cloud server configuration =====
# cp deploy/.env.example deploy/.env  &&  fill in the values marked REQUIRED.
# Keep .env out of git. Every variable here is read in server/app/config.py.

# --- identity / crypto (REQUIRED) -------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=
# Public origin of this deployment (no trailing slash)
PUBLIC_BASE=https://dshcloud.example.com
DHC_DOMAIN=dshcloud.example.com

# --- upstream LLM (REQUIRED — the key that never leaves the server) ---------
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.deepseek.com
# dsh web_search speaks Anthropic Messages; DeepSeek serves it here:
UPSTREAM_ANTHROPIC_BASE=https://api.deepseek.com/anthropic/v1

# --- pricing ----------------------------------------------------------------
MODEL_PRICE_MARKUP=1.2
FREE_SIGNUP_CREDITS=500
SEARCH_CALL_CREDITS=5

# --- database (sqlite by default; postgres optional) ------------------------
DB_BACKEND=sqlite
# DB_BACKEND=postgres
# POSTGRES_DSN=postgresql://dhc:password@postgres:5432/dhc

# --- mail (email verification codes) ----------------------------------------
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=

# --- payments (a provider activates when its variables are set) -------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_METHODS=card,alipay,wechat_pay

ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_APPID=

# --- admin / legal ----------------------------------------------------------
ADMIN_EMAILS=
LEGAL_ENTITY_ZH=AgentsDance AI
LEGAL_ENTITY_EN=Beijing AgentsDance AI Technology Co., Ltd.
LEGAL_CONTACT_EMAIL=
ICP_NUMBER=
PSB_NUMBER=

# --- desktop installer download urls (shown on /download) -------------------
DOWNLOAD_URL_MAC=
DOWNLOAD_URL_WIN=

# --- cloud workspaces (dshwork) ---------------------------------------------
WORK_ENABLED=0
WORK_DOMAIN=
# 工作台跑在哪: docker | eci
#   docker  本机引擎, 经受限 socket 代理。可 stop/start, 恢复几秒。自部署只有这条。
#   eci     阿里云弹性容器实例, 按秒计费、按需扩。
WORK_BACKEND=docker

# -- docker 后端 --
WORK_IMAGE=dsh-local:rc8
WORK_NETWORK=dshwork-net
DOCKER_PROXY_URL=http://dhc-docker-proxy:2375
# 宿主 docker 卷根目录 (docker info -f '{{.DockerRootDir}}')。只读挂进来, 让
# 「個人成品」在容器睡着的那 23 小时里仍然能列出用户的文件。留空则关闭该视图。
WORK_VOLUME_ROOT=

# -- eci 后端 --
# 仓库引用, 不是本地 tag。公开包无需凭据; 私有包要在 ECI 侧配镜像仓库凭据。
WORK_IMAGE_REF=ghcr.io/agentsdancepro/dsh-local:rc8
ECI_REGION_ID=ap-southeast-1
ECI_ZONE_ID=ap-southeast-1a
ECI_VSWITCH_ID=
# ⛔ 专用安全组, 只放行 3081 <- 应用机那一个 /32。绝不要复用应用机的安全组:
# 3081 那一跳没有任何应用层鉴权, 安全组是 ECI 上唯一的边界。
ECI_SECURITY_GROUP_ID=
# RAM 用户, 最小策略见 docs/workspace-scaling.md (七个 eci + 三个 vpc 动作,
# 刻意不含 eci:ExecContainerCommand)
ECI_ACCESS_KEY_ID=
ECI_ACCESS_KEY_SECRET=
ECI_COMPUTE_CATEGORY=economy
ECI_EIP_BANDWIDTH=100
# ⚠️ ECI 后端下 NAS 不是可选项: ECI 没有"停止但保留", 闲置回收就是删除,
# 不挂 NAS 的话用户的文件和会话会随回收消失 (启动时会告警)。
# 应用机上把同一个 NAS 挂到哪 (容器内路径)。留空则「個人成品」在 ECI 后端下
# 永远是空的 —— 那边容器闲置即销毁, 这是用户不在时列出他文件的唯一路径。
# 宿主侧挂载见 /etc/fstab (nofail,_netdev), compose 里以 :ro 挂进容器。
WORK_NAS_LOCAL_MOUNT=/nas
WORK_NAS_SERVER=
# 这个目录**必须已经存在于 NAS 上** —— ECI 不会替你建, 挂载会以
# "file does not exist" 失败, 而实例只是一直 Pending、不报错, 用户永远看着转圈。
# 用 / (根目录必然存在) 最省事; 想放子目录就先自己在 NAS 上建出来。
# 每用户的 <hexid>/home 与 <hexid>/workspace 由 SubPath 自动创建, 不用管。
WORK_NAS_PATH=/
