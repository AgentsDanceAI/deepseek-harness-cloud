# Development environment. Copied to .env by up.sh, which fills in the secrets.
#
# What is deliberately NOT here: Waffo keys, the production database, the
# production domain. A dev stack that can reach the real payment provider will
# eventually create a real product or answer a real webhook, and the way that
# gets discovered is a customer's receipt.

DHC_DEV=1
PUBLIC_BASE=http://127.0.0.1:18100
COOKIE_DOMAIN=
ALLOW_REGISTRATION=1
ADMIN_EMAILS=dev@localhost

# --- database ---------------------------------------------------------------
DB_BACKEND=postgres
POSTGRES_DB=dhcdev
POSTGRES_USER=dhcdev
POSTGRES_PASSWORD=            # up.sh generates one
POSTGRES_DSN=postgresql://dhcdev:__PW__@dhc-dev-postgres:5432/dhcdev
AUTH_SECRET=                  # up.sh generates one

# --- pricing ----------------------------------------------------------------
PRICING_FILE=pricing.usd.json
MODEL_PRICE_MARKUP=1.2
FREE_SIGNUP_CREDITS=500

# --- upstream ---------------------------------------------------------------
# Blank means the pages all work and the gateway does not. Paste a key here
# only when you are actually exercising model calls — dev traffic bills to the
# same account production does.
UPSTREAM_BASE_URL=https://api.qianmian.ai
UPSTREAM_API_KEY=

# --- payments ---------------------------------------------------------------
# Left empty on purpose: with no provider configured, checkout records the
# intent and the UI says payment is not available yet. That is the correct dev
# behaviour and it is one env var away from being wrong.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=

# --- cloud workspace --------------------------------------------------------
WORK_ENABLED=1
WORK_IMAGE=dsh-local:rc6
WORK_NETWORK=dshwork-dev-net
WORK_DOMAIN=127.0.0.1:18100
DOCKER_PROXY_URL=http://dhc-dev-docker-proxy:2375
WORK_FREE_MINUTES=180
WORK_MAX_CONCURRENT=4
# Host docker volume root, so 個人成品 can read a stopped workspace.
# docker info -f '{{.DockerRootDir}}'  →  append /volumes
DOCKER_VOLUME_ROOT=/mnt/docker/volumes
