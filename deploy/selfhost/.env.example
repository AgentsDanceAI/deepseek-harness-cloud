# =============================================================================
#  DSH Cloud (deepseek-harness-cloud) — self-host configuration
#  自部署配置模板：cp .env.example .env 后按标注填写（或直接跑 scripts/quickstart.sh）
#
#  Legend / 图例
#    [REQUIRED  必填]  nothing works (or the server refuses to start) without it
#    [OPTIONAL  可选]  the feature stays off until you fill it in
#    [PRIVATE   私有化] suggested value for an internal / enterprise deployment
#    [COMPOSE]         read by docker-compose.yml, not by the app
#
#  Rules / 注意
#    - No quotes needed and no shell expansion: VALUE is taken literally.
#      值不要加引号，$ 不会被展开。
#    - Never commit this file once filled in. 填好后不要提交到 git。
#    - Every app variable below exists in server/app/config.py — defaults quoted
#      here are that file's defaults. 变量名与默认值均以 config.py 为准。
# =============================================================================


# =============================================================================
#  1. Site / 站点地址
# =============================================================================

# [REQUIRED 必填][COMPOSE] The hostname this deployment answers on.
#   dsh.example.com   -> Caddy obtains a Let's Encrypt certificate for it
#                        (DNS A/AAAA record must already point at this host)
#   localhost         -> local trial mode, no TLS, no DNS, no certificate
DOMAIN=dsh.example.com

# [REQUIRED 必填][COMPOSE] https for a real domain, http for DOMAIN=localhost.
# 真实域名填 https；本地体验（DOMAIN=localhost）填 http，全程不签证书。
SITE_SCHEME=https

# [OPTIONAL 可选] Public origin the app believes it is reachable at, no trailing
# slash. Leave EMPTY: it is derived as ${SITE_SCHEME}://${DOMAIN}. Set it only
# when another proxy/CDN sits in front, or when you use a non-standard port
# (then include the port, e.g. http://localhost:8080).
# OAuth callbacks, payment return URLs and the cloud-workspace gateway URL are
# all built from this value — a wrong value breaks login and payments.
PUBLIC_BASE=

# [OPTIONAL 可选][COMPOSE] Host ports Caddy publishes. Change only on a port
# clash; a value other than 80/443 must also appear in PUBLIC_BASE, and
# Let's Encrypt's HTTP/TLS-ALPN challenges then need external 80/443 forwarded
# here. 端口冲突时才改，非 80/443 需同步写进 PUBLIC_BASE。
HTTP_PORT=80
HTTPS_PORT=443

# [REQUIRED 必填] Signing key for session cookies and device tokens.
#   generate / 生成:   openssl rand -hex 32
#   Empty  -> the server refuses to start ("AUTH_SECRET must be set").
#   留空   -> 服务启动直接失败。
#   Rotating it logs every user and device out; stored data is untouched.
AUTH_SECRET=

# [OPTIONAL 可选] Development switch. 1 => login codes are PRINTED to the
# container log instead of being e-mailed, the session cookie drops its Secure
# flag, /api/docs opens. Set 1 for DOMAIN=localhost (otherwise you cannot log in
# without SMTP). MUST be 0 on a public deployment. 生产环境必须为 0。
DHC_DEV=0

# [OPTIONAL 可选] Token lifetimes in seconds. Defaults: 90 days / 365 days.
# AUTH_TOKEN_TTL=7776000
# DEVICE_TOKEN_TTL=31536000


# =============================================================================
#  2. Model upstream / 模型上游  —— the money secret, never leaves the server
# =============================================================================
# Any OpenAI-compatible endpoint works: DeepSeek official, a reseller gateway,
# vLLM/Ollama on your own GPUs. The gateway POSTs to ${UPSTREAM_BASE_URL}/chat/
# completions, so the value MUST include the version path (usually /v1).

# [REQUIRED 必填] Example values / 常见取值:
#   https://api.deepseek.com/v1          DeepSeek official
#   https://api.qianmian.ai/v1           (config.py default)
#   http://vllm.internal:8000/v1         [PRIVATE 私有化] your own inference
UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# [REQUIRED 必填] The upstream API key. Get it from your provider's console
# (DeepSeek: https://platform.deepseek.com/api_keys). It is read only by
# server/app/gateway.py and is never sent to any client.
#   Empty -> the app still starts but every /llm request answers 503.
#   留空  -> 服务能起来，但所有模型请求返回 503。
UPSTREAM_API_KEY=

# [OPTIONAL 可选] Upstream read timeout in seconds (default 600 — long agent
# turns are normal). UPSTREAM_TIMEOUT_S=600

# [OPTIONAL 可选] Model catalogue and list prices live in
# server/config/models.json (bind-mounted read-only by docker-compose.yml, so
# you can edit it in the repo and just restart). The shipped ids are
# deepseek-v4-flash / deepseek-v4-pro; if your upstream serves other names,
# either change "upstream_model" there or rename the ids — an id that is not in
# that file answers 404 model_not_found.
# 上游模型名与目录里的 id 对不上时，请改 server/config/models.json。


# =============================================================================
#  3. Web search / 联网搜索  —— optional
# =============================================================================
# dsh's web_search tool speaks the Anthropic Messages protocol. Two backends:
#   zhipu     translate to Zhipu web search (open.bigmodel.cn), cheap per call
#   upstream  proxy verbatim to UPSTREAM_ANTHROPIC_BASE/messages (a full billed
#             model turn on DeepSeek's official Anthropic-compatible endpoint)

# [OPTIONAL 可选] zhipu (config.py default) | upstream
SEARCH_PROVIDER=zhipu

# [OPTIONAL 可选] Apply for a key at https://open.bigmodel.cn (智谱开放平台 ->
# 搜索 web_search). Required when SEARCH_PROVIDER=zhipu.
#   Empty -> web_search answers 503 search_not_configured: the agent still
#            chats and codes, it just cannot browse the web.
#   留空  -> 智能体无法联网搜索，其余功能不受影响。
ZHIPU_SEARCH_API_KEY=

# [OPTIONAL 可选] Engine ladder — the default leads with the engine that returns
# real links (rows without a url are discarded by dsh).
# ZHIPU_SEARCH_ENGINE=search_pro_sogou
# ZHIPU_SEARCH_FALLBACKS=search_pro,search_std
# ZHIPU_SEARCH_BASE=https://open.bigmodel.cn/api/paas/v4

# [OPTIONAL 可选] Only used when SEARCH_PROVIDER=upstream.
# UPSTREAM_ANTHROPIC_BASE=https://api.deepseek.com/anthropic/v1


# =============================================================================
#  4. Sign-in / 登录
# =============================================================================
# Three ways in, all optional to configure:
#   password  email + password, works with no configuration at all
#   e-mail    6-digit login code — needs SMTP below
#   OAuth     Google / GitHub — a provider activates when its pair is set

# --- SMTP (login codes) / 邮箱验证码 -----------------------------------------
# [OPTIONAL 可选] Any provider works (Gmail app password, SES, Aliyun DM, ...).
# The client connects with implicit TLS (SMTP_SSL), so use the SSL port (465).
#   Empty -> POST /api/auth/email/send answers 503 mail_not_configured; users
#            can still register/log in with email + password.
#   留空  -> 只能用「邮箱 + 密码」注册登录，验证码登录不可用。
#   With DHC_DEV=1 the code is printed to the log instead — handy for local runs.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Envelope sender. Fill it in whenever SMTP is configured — an empty value stays
# empty (the config default only applies when the line is absent), and most
# servers reject a message with no From. 配了 SMTP 就必须填，通常与 USER 相同。
MAIL_FROM=

# --- OAuth / 第三方登录 -------------------------------------------------------
# [OPTIONAL 可选] Google: https://console.cloud.google.com/apis/credentials
#   -> OAuth client ID (Web application)
#   -> Authorized redirect URI MUST be exactly:
#      ${PUBLIC_BASE}/api/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Override only if the callback differs from the derived one.
# GOOGLE_LOGIN_REDIRECT_URI=

# [OPTIONAL 可选] GitHub: https://github.com/settings/developers -> New OAuth App
#   -> Authorization callback URL MUST be exactly:
#      ${PUBLIC_BASE}/api/auth/github/callback
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# GITHUB_LOGIN_REDIRECT_URI=

# [OPTIONAL 可选] Create an account on first OAuth login (default 1).
# [PRIVATE 私有化] 0 = only people you invited (pre-created accounts) can enter.
OAUTH_AUTO_REGISTER=1

# [OPTIONAL 可选] Self-service registration (default 1).
# [PRIVATE 私有化] Set 0 after creating your team's accounts: the deployment
# becomes invite-only. 内部私有化建议开好账号后置 0。
ALLOW_REGISTRATION=1


# =============================================================================
#  5. Credits & pricing / 积分与计费
# =============================================================================
# $1 = 100 credits, i.e. 1 credit = $0.01 of listed model usage (model list
# prices in config/models.json are USD per 1M tokens). Charges = list × markup.

# [OPTIONAL 可选] Gross-margin multiplier applied to every charge (default 1.2).
MODEL_PRICE_MARKUP=1.2
# [OPTIONAL 可选] Credits granted on signup (default 500).
# [PRIVATE 私有化] A large number (e.g. 1000000) makes the meter effectively
# invisible to your own staff. 内部部署可给一个很大的数。
FREE_SIGNUP_CREDITS=500
# [OPTIONAL 可选] Flat charge per successful web_search call (default 5).
SEARCH_CALL_CREDITS=5
# [OPTIONAL 可选] How far a user may go negative while in-flight streams finish
# (default 200). Streams are never cut mid-answer; gates close afterwards.
OVERDRAFT_LIMIT_CREDITS=200
# [OPTIONAL 可选] Plan/credit-pack price list: pricing.json (CNY, default) or
# pricing.usd.json (USD). Edit the file in server/config/ — it is the single
# source of truth for amounts; the client is never trusted.
PRICING_FILE=pricing.json

# [OPTIONAL 可选] Team seats: price per seat per cycle (minor units of the
# pricing file's currency) and the pooled credits each seat contributes.
TEAM_SEAT_PRICE=1500
TEAM_SEAT_CREDITS=3500

# [OPTIONAL 可选] Per-user gateway guards (defaults 5.0 / 15).
GATEWAY_QPS=5.0
GATEWAY_QPS_BURST=15
# [OPTIONAL 可选] Credit gating master switch (default 1 = enforce).
# [PRIVATE 私有化] 0 = never block on balance — an internal deployment where you
# only want the usage LEDGER, not the wall. 内部部署可设 0：只记账不拦人。
ENTITLE_ENFORCE=1


# =============================================================================
#  6. Payments / 支付  —— optional, a provider activates when its vars are set
# =============================================================================
# With none configured the pricing page degrades to "coming soon" and records
# purchase intent. 一个都不配时，购买按钮降级为意向收集，不影响其他功能。
# Webhook URLs to register with each provider:
#   ${PUBLIC_BASE}/api/pay/webhook/stripe|alipay|wechat|waffo

# [OPTIONAL 可选] Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_METHODS=card,alipay,wechat_pay

# [OPTIONAL 可选] Alipay 支付宝开放平台 — https://open.alipay.com
# PEM keys must be a SINGLE line; write newlines as \n.
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# [OPTIONAL 可选] WeChat Pay 微信支付商户平台 — https://pay.weixin.qq.com
# WECHAT_PAY_PRIVATE_KEY_PATH points at a file INSIDE the container: mount it
# yourself (add a read-only volume to dhc-server in docker-compose.yml).
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_APPID=

# [OPTIONAL 可选] Waffo (overseas merchant of record) — https://waffo.ai
# WAFFO_ENV=test switches to their sandbox. Private key: single line, \n escaped.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_PRODUCT_ID=
WAFFO_STORE_ID=
WAFFO_ENV=test
# WAFFO_API_BASE=https://api.waffo.ai


# =============================================================================
#  7. Cloud workspaces / 云工作台  —— optional, needs the host docker engine
# =============================================================================
# Gives every user a browser-usable dsh container (phone included). It costs you
# RAM and it hands users a code-executing sandbox, so it is OFF by default.
#
# To enable, ALL of these must line up:
#   1. WORK_ENABLED=1                        (app switch, below)
#   2. COMPOSE_PROFILES=work                 (starts the scoped docker proxy)
#   3. WORK_DOMAIN=work.<your domain> + a DNS record pointing here
#   4. COOKIE_DOMAIN=.<your domain>          (session must reach the subdomain)
#   5. the WORK_IMAGE image present on this host (build recipe in README.md)
# Requires a real HTTPS domain: the app redirects to https://${WORK_DOMAIN}/,
# so DOMAIN=localhost cannot run workspaces. 本地 localhost 模式无法用云工作台。

# [OPTIONAL 可选] Master switch (default 0 = off).
WORK_ENABLED=0

# [COMPOSE] Leave EMPTY while workspaces are off — the docker socket is then not
# mounted anywhere, and Caddy requests no certificate for the work subdomain.
# 关闭时留空：不挂载 docker socket，也不会去申请 work 子域证书。
COMPOSE_PROFILES=

# [OPTIONAL 可选] Host serving the dsh UI. Empty while disabled.
WORK_DOMAIN=

# [OPTIONAL 可选] Cookie scope. Empty = host-only cookie (single-domain deploy).
# Set to .example.com (leading dot) so the session also reaches work.example.com.
COOKIE_DOMAIN=

# [OPTIONAL 可选] The per-user container image. Must exist on THIS host —
# nothing pulls it for you. Build it with the recipe in README.md §Cloud
# workspaces (node + `npm i -g @deepseek-ai/dsh@<version>` + socat).
WORK_IMAGE=dsh-local:rc6

# [OPTIONAL 可选][COMPOSE] Docker network the workspace containers join. The
# compose file creates a network with exactly this name, and the app attaches
# containers to it — keep the two identical.
WORK_NETWORK=dshwork-net

# [OPTIONAL 可选] Scoped docker API endpoint. Matches the compose service name;
# change only if you rename that service.
# DOCKER_PROXY_URL=http://dhc-docker-proxy:2375

# [OPTIONAL 可选] Metering and capacity (defaults shown).
#   credits charged per ACTIVE minute (a minute the agent actually called the
#   gateway — reading a reply or leaving a tab open is free)
WORK_CREDITS_PER_MIN=2
#   stop the container after this many minutes without browser traffic
WORK_IDLE_STOP_MIN=15
#   capacity backstop: stop it after this many minutes with no agent work
WORK_AGENT_IDLE_STOP_MIN=30
#   global cap on simultaneously running workspaces — size it against RAM:
#   WORK_MAX_CONCURRENT × WORK_MEM_LIMIT_MB must fit on the host
WORK_MAX_CONCURRENT=40
#   free ACTIVE agent minutes every user gets per calendar month; after that the
#   next task asks them to move up a plan (each plan includes more machine
#   hours). Credits pay for the tokens; these minutes pay for the machine.
#   The separately sold "workspace pass" was withdrawn — WORK_PASS_* no longer
#   exists. [PRIVATE 私有化] set WORK_FREE_MINUTES very high to remove the paywall.
WORK_FREE_MINUTES=180
WORK_MEM_LIMIT_MB=512
WORK_CPUS=1.0
WORK_START_TIMEOUT_S=45.0


# =============================================================================
#  8. Admin, database, branding / 管理员、数据库、品牌
# =============================================================================

# [REQUIRED 必填] Comma-separated admin e-mails. The account registered with one
# of these addresses gets /api/admin/* (list users, grant credits, set plans,
# suspend accounts, publish desktop versions). No separate admin signup exists —
# this list IS the admin bootstrap. 用这些邮箱注册的账号即管理员。
ADMIN_EMAILS=you@example.com

# [OPTIONAL 可选] sqlite (default) | postgres. SQLite lives in the dhc-data
# volume at /app/data/dhc.db (WAL) and is plenty for early usage; switch to
# postgres before running multiple workers/hosts.
DB_BACKEND=sqlite
# POSTGRES_DSN=postgresql://dhc:password@postgres:5432/dhc
# DB_PATH=/app/data/dhc.db

# [OPTIONAL 可选] Shown in the footer and on the legal pages. Replace with your
# own entity before going public. 上线前请换成你自己的主体信息。
LEGAL_ENTITY_ZH=
LEGAL_ENTITY_EN=
LEGAL_CONTACT_EMAIL=
# Mainland-China filings, rendered in the footer when set.
ICP_NUMBER=
PSB_NUMBER=
# Directory holding terms/privacy/refund/aup as <name>.zh.md. The legal pages
# render "待发布" until real documents exist there (see docker-compose.yml).
# DHC_LEGAL_DIR=/srv/legal

# [OPTIONAL 可选] Desktop installer links shown on /download. Drop the files
# into the dhc-data volume under releases/ and point these at
# ${PUBLIC_BASE}/releases/<filename>.
DOWNLOAD_URL_MAC=
DOWNLOAD_URL_WIN=
DOWNLOAD_URL_MAC_X64=
DOWNLOAD_URL_ANDROID=
# Version the desktop auto-updater advertises (admins can also set it at
# runtime via POST /api/admin/desktop-version).
# DESKTOP_VERSION=
