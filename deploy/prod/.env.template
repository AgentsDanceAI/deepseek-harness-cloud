# Overseas deployment config (this is the operator's own template, kept in-repo
# as a worked example — see deploy/selfhost/.env.example for the documented one).
# Values marked <from-secret-store> come from the operator's secret manager at
# deploy time and are never written into this file. Non-secret values are final.

# --- identity / public ---
AUTH_SECRET=<generate: openssl rand -hex 32>
PUBLIC_BASE=https://dshcloud.online
DHC_DEV=0

# --- pricing (overseas = USD, Waffo) ---
PRICING_FILE=pricing.usd.json
MODEL_PRICE_MARKUP=1.2
FREE_SIGNUP_CREDITS=500
SEARCH_CALL_CREDITS=5

# --- model gateway: Alibaba qianmian (OpenAI-compatible, serves deepseek-v4-*) ---
UPSTREAM_BASE_URL=https://api.qianmian.ai/v1
UPSTREAM_API_KEY=<from-secret-store:SG_MODEL_GATEWAY_KEY>

# --- web_search: Zhipu (open.bigmodel.cn), replaces paid DeepSeek search ---
SEARCH_PROVIDER=zhipu
ZHIPU_SEARCH_API_KEY=<from-secret-store:ZHIPU_SEARCH_API_KEY>
ZHIPU_SEARCH_ENGINE=search_pro

# --- login: Google + GitHub + email code ---
GOOGLE_LOGIN_CLIENT_ID=<from-secret-store:AGENT_PLUGIN_GOOGLE_CLIENT_ID>
GOOGLE_LOGIN_CLIENT_SECRET=<from-secret-store:AGENT_PLUGIN_GOOGLE_CLIENT_SECRET>
GOOGLE_LOGIN_REDIRECT_URI=https://dshcloud.online/api/auth/google/callback
GITHUB_LOGIN_CLIENT_ID=<from-secret-store:GITHUB_LOGIN_CLIENT_ID>
GITHUB_LOGIN_CLIENT_SECRET=<from-secret-store:GITHUB_LOGIN_CLIENT_SECRET>
GITHUB_LOGIN_REDIRECT_URI=https://dshcloud.online/api/auth/github/callback
OAUTH_AUTO_REGISTER=1
ALLOW_REGISTRATION=1

# --- email (verification codes) ---
MAIL_SMTP_HOST=<from-secret-store:MAIL_SMTP_HOST>
MAIL_SMTP_PORT=<from-secret-store:MAIL_SMTP_PORT>
MAIL_SMTP_USER=<from-secret-store:MAIL_SMTP_USER>
MAIL_SMTP_PASS=<from-secret-store:MAIL_SMTP_PASSWORD>
MAIL_FROM=<from-secret-store:MAIL_FROM>

# --- payments: Waffo ---
WAFFO_ENV=prod
WAFFO_MERCHANT_ID=<from-secret-store:WAFFO_MERCHANT_ID>
WAFFO_PRIVATE_KEY=<from-secret-store:WAFFO_PRIVATE_KEY>
WAFFO_WEBHOOK_PUBLIC_KEY=<from-secret-store:WAFFO_WEBHOOK_PUBLIC_KEY>
WAFFO_API_BASE=https://api.waffo.ai

# --- admin / legal ---
ADMIN_EMAILS=<from-secret-store>
LEGAL_ENTITY_EN=Beijing AgentsDance AI Technology Co., Ltd.
LEGAL_CONTACT_EMAIL=<from-secret-store>
