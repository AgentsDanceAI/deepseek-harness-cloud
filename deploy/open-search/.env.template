# open-search.ai (overseas) deployment config.
# Secrets marked <from-144> are pulled from ***REDACTED-PATH***/.env
# on ***REDACTED-HOST***. Non-secret values are final.

# --- identity / public ---
AUTH_SECRET=<generate: openssl rand -hex 32>
PUBLIC_BASE=https://open-search.ai
DHC_DEV=0

# --- pricing (overseas = USD, Waffo) ---
PRICING_FILE=pricing.usd.json
MODEL_PRICE_MARKUP=1.2
FREE_SIGNUP_CREDITS=500
SEARCH_CALL_CREDITS=5

# --- model gateway: Alibaba qianmian (OpenAI-compatible, serves deepseek-v4-*) ---
UPSTREAM_BASE_URL=https://api.qianmian.ai/v1
UPSTREAM_API_KEY=<from-144: SG_MODEL_GATEWAY_KEY>

# --- web_search: Zhipu (open.bigmodel.cn), replaces paid DeepSeek search ---
SEARCH_PROVIDER=zhipu
ZHIPU_SEARCH_API_KEY=<from-144: ZHIPU_SEARCH_API_KEY>
ZHIPU_SEARCH_ENGINE=search_pro

# --- login: Google + GitHub + email code ---
GOOGLE_LOGIN_CLIENT_ID=<from-144: AGENT_PLUGIN_GOOGLE_CLIENT_ID>
GOOGLE_LOGIN_CLIENT_SECRET=<from-144: AGENT_PLUGIN_GOOGLE_CLIENT_SECRET>
GOOGLE_LOGIN_REDIRECT_URI=https://open-search.ai/api/auth/google/callback
GITHUB_LOGIN_CLIENT_ID=<from-144: GITHUB_LOGIN_CLIENT_ID>
GITHUB_LOGIN_CLIENT_SECRET=<from-144: GITHUB_LOGIN_CLIENT_SECRET>
GITHUB_LOGIN_REDIRECT_URI=https://open-search.ai/api/auth/github/callback
OAUTH_AUTO_REGISTER=1
ALLOW_REGISTRATION=1

# --- email (verification codes) ---
MAIL_SMTP_HOST=<from-144: MAIL_SMTP_HOST>
MAIL_SMTP_PORT=<from-144: MAIL_SMTP_PORT>
MAIL_SMTP_USER=<from-144: MAIL_SMTP_USER>
MAIL_SMTP_PASS=<from-144: MAIL_SMTP_PASSWORD>
MAIL_FROM=<from-144: MAIL_FROM>

# --- payments: Waffo ---
WAFFO_ENV=prod
WAFFO_MERCHANT_ID=<from-144: WAFFO_MERCHANT_ID>
WAFFO_PRIVATE_KEY=<from-144: WAFFO_PRIVATE_KEY>
WAFFO_WEBHOOK_PUBLIC_KEY=<from-144: WAFFO_WEBHOOK_PUBLIC_KEY>
WAFFO_API_BASE=https://api.waffo.ai

# --- admin / legal ---
ADMIN_EMAILS=***REDACTED-EMAIL***
LEGAL_ENTITY_EN=Beijing AgentsDance AI Technology Co., Ltd.
LEGAL_CONTACT_EMAIL=***REDACTED-EMAIL***
