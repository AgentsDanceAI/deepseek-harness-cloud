diff --git a/web/src/assistant-name.ts b/web/src/assistant-name.ts
new file mode 100644
index 0000000..d5054a1
--- /dev/null
+++ b/web/src/assistant-name.ts
@@ -0,0 +1,21 @@
+/**
+ * 助手在界面上叫什么。
+ *
+ * 原先界面各处写死 "pi"：左上角品牌、标签页标题、消息上的角色名、输入框占位。
+ * 接了 Claude Code / Codex 之后这些字全不对 —— 用户对着一个写着 pi 的界面在跟
+ * Codex 说话。
+ *
+ * 名字由服务端在 `ready` 里给 (engineName, 见 server/index.ts)，**跟着引擎定义
+ * 走**；这里只负责把它送到那几个叶子组件, 免得为一个字符串一路钻 prop ——
+ * Message / CollapsedMessage 都是 memo 的, 多一个 prop 会影响它们的比较。
+ *
+ * 缺省 "pi"：上游的 pi / dsh 两个引擎观感一个字不变。
+ */
+
+import { createContext, useContext } from "react";
+
+export const AssistantNameContext = createContext<string>("pi");
+
+export function useAssistantName(): string {
+	return useContext(AssistantNameContext);
+}
diff --git a/web/src/boot-engine-name.ts b/web/src/boot-engine-name.ts
new file mode 100644
index 0000000..3b7d21b
--- /dev/null
+++ b/web/src/boot-engine-name.ts
@@ -0,0 +1,25 @@
+/**
+ * 首帧就知道自己叫什么。
+ *
+ * 引擎名走 `ready` 帧, 而 ready 是 WebSocket 连上之后的事 —— 在那之前左上角
+ * 先画「π pi-web-ui」, 连上才跳成「C Claude Code」。用户第一眼看到的是一个
+ * 别的产品名闪一下再被盖掉 (老板 2026-09-11: "先出现 pi-web-ui, 再叠加的
+ * claude code, 合适吗")。
+ *
+ * 所以服务端把名字烧进发出去的 HTML (server/index.ts 的 brandedIndexHtml),
+ * 这里读出来当**首帧回落值**。ready 到了照样以 chat.engineName 为准 —— 这只是
+ * 把"还不知道"的那一小段填上。
+ *
+ * 上游自己跑 (pi / dsh) 时服务端不烧, 这里是 undefined, 一切照旧。
+ */
+
+declare global {
+	interface Window {
+		__PI_ENGINE_NAME__?: string;
+		/** 实例默认皮肤 (PI_WEB_DEFAULT_THEME)。见 web/src/theme.ts。 */
+		__PI_DEFAULT_THEME__?: string;
+	}
+}
+
+export const BOOT_ENGINE_NAME: string | undefined =
+	typeof window !== "undefined" && window.__PI_ENGINE_NAME__ ? window.__PI_ENGINE_NAME__ : undefined;
