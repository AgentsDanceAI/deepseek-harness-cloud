+describe("首帧就带上引擎名", () => {
+	const RAW =
+		'<!doctype html>\n<html lang="zh-CN">\n\t<head>\n\t\t<title>pi-web-ui — pi 编码智能体</title>\n\t</head>\n\t<body></body>\n</html>\n';
+
+	it("标题换成引擎名, 并把名字塞给首帧", () => {
