diff --git a/tests/unit/cli-engine-adapter.test.ts b/tests/unit/cli-engine-adapter.test.ts
new file mode 100644
index 0000000..48e88c5
--- /dev/null
+++ b/tests/unit/cli-engine-adapter.test.ts
@@ -0,0 +1,212 @@
+/**
+ * 第三个引擎的适配层。钉的是**上游 CLI 的 wire 格式**。
+ *
+ * 这些样本是从真 CLI 抓的原样输出 (claude 2.1.193 / codex exec --json), 不是照
+ * 文档编的。CLI 改格式时这里会**静默失配** —— 症状是"发了消息没反应", 没有
+ * 任何报错, 查起来毫无线索。所以宁可让测试先红。
+ */
+
+import { describe, expect, it } from "vitest";
+import { claudeSpec, codexSpec } from "../../server/cli/cli-adapter.js";
+
+describe("claude 适配", () => {
+	it("从 system/init 认出 session id（用于 --resume）", () => {
+		const line = JSON.stringify({ type: "system", subtype: "init", session_id: "s-1", cwd: "/x" });
+		expect(claudeSpec.feed(line)).toEqual([{ t: "session", id: "s-1" }]);
+	});
+
+	it("text_delta 出流式增量", () => {
+		const line = JSON.stringify({
+			type: "stream_event",
+			event: { type: "content_block_delta", delta: { type: "text_delta", text: "你好" } },
+		});
+		expect(claudeSpec.feed(line)).toEqual([{ t: "delta", text: "你好" }]);
+	});
+
+	it("result 带出用量（缓存命中单列）", () => {
+		const line = JSON.stringify({
+			type: "result",
+			usage: { input_tokens: 10, output_tokens: 3, cache_read_input_tokens: 7 },
+		});
+		expect(claudeSpec.feed(line)).toEqual([{ t: "done", usage: { input: 10, output: 3, cacheRead: 7 } }]);
+	});
+
+	it("认不出的行原样透传成 raw，不丢掉", () => {
+		// 丢掉的症状是"发了消息没反应", 而 raw 至少能在调试面板里看见。
+		expect(claudeSpec.feed('{"type":"brand_new_thing"}')[0]!.t).toBe("raw");
+		expect(claudeSpec.feed("这不是 JSON")[0]!.t).toBe("raw");
+	});
+
+	it("argv 带 --model，且 resume 时接上 --resume", () => {
+		const a = claudeSpec.argv("hi", "s-9", "claude-sonnet-5");
+		expect(a).toContain("--model");
+		expect(a[a.indexOf("--model") + 1]).toBe("claude-sonnet-5");
+		expect(a[a.indexOf("--resume") + 1]).toBe("s-9");
+	});
+});
+
+describe("codex 适配", () => {
+	it("thread.started 就是会话 id", () => {
+		expect(codexSpec.feed(JSON.stringify({ type: "thread.started", thread_id: "th-1" }))).toEqual([
+			{ t: "session", id: "th-1" },
+		]);
+	});
+
+	it("正文走 text 而不是 delta —— 它没有流式增量", () => {
+		// 走 delta 的话前端会画光标动画, 而那边其实一次性给完, 看起来像卡住。
+		const line = JSON.stringify({ type: "item.completed", item: { type: "agent_message", text: "好了" } });
+		expect(codexSpec.feed(line)).toEqual([{ t: "text", text: "好了" }]);
+	});
+
+	it("-m 是按次指定的（dsh 引擎换模型要重启运行时，这里不用）", () => {
+		const a = codexSpec.argv("hi", null, "gpt-5.6-luna");
+		expect(a[a.indexOf("-m") + 1]).toBe("gpt-5.6-luna");
+	});
+
+	it("turn.failed 出 error，不当成正常结束", () => {
+		expect(codexSpec.feed(JSON.stringify({ type: "turn.failed" }))[0]!.t).toBe("error");
+	});
+});
+
+describe("codex 的错误不许被丢掉", () => {
+	it("item.completed 里 type=error 的那种也出 error 事件", () => {
+		// 实测抓的原文 (走 AI Store 网关, -m claude-fable-5)。
+		const line = JSON.stringify({
+			type: "item.completed",
+			item: {
+				id: "item_0",
+				type: "error",
+				message: "Model metadata for `claude-fable-5` not found. Defaulting to fallback metadata; this can degrade performance and cause issues.",
+			},
+		});
+		expect(codexSpec.feed(line)).toEqual([
+			{ t: "error", message: expect.stringContaining("Model metadata for `claude-fable-5` not found") },
+		]);
+	});
+
+	it("turn.failed 照旧出 error", () => {
+		const line = JSON.stringify({ type: "turn.failed", error: { message: "boom" } });
+		expect(codexSpec.feed(line)[0]!.t).toBe("error");
+	});
+});
+
+describe("子进程的 stdin 必须关掉", () => {
+	/**
+	 * codex 的 prompt 走 argv 而不是 stdin —— 但它**照样读 stdin**, 开口第一句
+	 * 就是 `Reading additional input from stdin...`, 不给 EOF 就一直等。
+	 *
+	 * 这条钉的是 spec 的形状 (codex 不走 stdin), 真正"有没有关"那条在
+	 * tests/cli-engine-stdin-test.mjs 里用真子进程验 —— 只钉这里的话, 把
+	 * child.stdin.end() 删掉照样全绿, 而用户那边是"正在思考"转到天荒地老。
+	 */
+	it("codex 的 prompt 走 argv, 不走 stdin", () => {
+		expect(codexSpec.stdinPrompt).toBe(false);
+		expect(codexSpec.stdinPayload("hi")).toBeNull();
+		expect(codexSpec.argv("说句话", null, "gpt-5.6-luna")).toContain("说句话");
+	});
+});
+
+describe("工具帧 —— 形状全是实测抓来的", () => {
+	it("claude: content_block_start 起卡片, input_json_delta 补参数", () => {
+		const start = JSON.stringify({
+			type: "stream_event",
+			event: {
+				type: "content_block_start",
+				index: 1,
+				content_block: { type: "tool_use", id: "toolu_1", name: "Bash", input: {} },
+			},
+		});
+		expect(claudeSpec.feed(start)).toEqual([{ t: "tool", id: "toolu_1", name: "Bash", input: {} }]);
+
+		const d = JSON.stringify({
+			type: "stream_event",
+			event: { type: "content_block_delta", index: 1, delta: { type: "input_json_delta", partial_json: '{"command": "echo hi"}' } },
+		});
+		expect(claudeSpec.feed(d)).toEqual([{ t: "tool_args", id: "toolu_1", delta: '{"command": "echo hi"}' }]);
+	});
+
+	it("claude: 工具结果那条 type=user 不是用户发言", () => {
+		// 实测原文 (echo HELLO-TOOL 那一轮)。
+		const line = JSON.stringify({
+			type: "user",
+			message: {
+				role: "user",
+				content: [{ tool_use_id: "toolu_1", type: "tool_result", content: "HELLO-TOOL", is_error: false }],
+			},
+		});
+		expect(claudeSpec.feed(line)).toEqual([{ t: "tool_end", id: "toolu_1", ok: true, output: "HELLO-TOOL" }]);
+	});
+
+	it("claude: 真的用户发言不会被当成工具结果", () => {
+		const line = JSON.stringify({ type: "user", message: { role: "user", content: [{ type: "text", text: "你好" }] } });
+		expect(claudeSpec.feed(line)).toEqual([]);
+	});
+
+	it("claude: 工具结果的 content 是块数组时也要拼出文本", () => {
+		const line = JSON.stringify({
+			type: "user",
+			message: {
+				role: "user",
+				content: [
+					{ tool_use_id: "t2", type: "tool_result", content: [{ type: "text", text: "一" }, { type: "text", text: "二" }], is_error: true },
+				],
+			},
+		});
+		expect(claudeSpec.feed(line)).toEqual([{ t: "tool_end", id: "t2", ok: false, output: "一\n二" }]);
+	});
+
+	it("codex: item.started 先出卡片, 标题用命令本身", () => {
+		const line = JSON.stringify({
+			type: "item.started",
+			item: { id: "item_1", type: "command_execution", command: "/bin/bash -lc 'echo HELLO-TOOL'", aggregated_output: "", exit_code: null, status: "in_progress" },
+		});
+		const out = codexSpec.feed(line);
+		expect(out).toHaveLength(1);
+		expect(out[0]!.t).toBe("tool");
+		// command_execution 这个词对用户没用, 命令本身才有用。
+		expect((out[0] as { name: string }).name).toContain("echo HELLO-TOOL");
+	});
+
+	it("codex: item.completed 同时补卡片和结果 (旧版只发 completed)", () => {
+		const line = JSON.stringify({
+			type: "item.completed",
+			item: { id: "item_1", type: "command_execution", command: "echo hi", aggregated_output: "HELLO-TOOL\n", exit_code: 0, status: "completed" },
+		});
+		const out = codexSpec.feed(line);
+		expect(out.map((e) => e.t)).toEqual(["tool", "tool_end"]);
+		expect(out[1]).toMatchObject({ t: "tool_end", id: "item_1", ok: true, output: "HELLO-TOOL\n" });
+	});
+
+	it("codex: 非零退出码要标成失败", () => {
+		const line = JSON.stringify({
+			type: "item.completed",
+			item: { id: "item_2", type: "command_execution", command: "false", aggregated_output: "", exit_code: 1, status: "completed" },
+		});
+		expect(codexSpec.feed(line).at(-1)).toMatchObject({ t: "tool_end", ok: false });
+	});
+});
+
+describe("思考档位 —— 只报这个 CLI 真能给的", () => {
+	it("claude: 五档, 默认与它自己不传参数时的行为一致 (抓包是 high)", () => {
+		expect([...claudeSpec.thinkingLevels]).toEqual(["low", "medium", "high", "xhigh", "max"]);
+		expect(claudeSpec.defaultThinking).toBe("high");
+		expect(claudeSpec.thinkingArgs("xhigh")).toEqual(["--effort", "xhigh"]);
+		// off / minimal 不在表里 —— claude 2.1.193 传了会 Warning 然后忽略。
+		expect(claudeSpec.thinkingLevels).not.toContain("off");
+		expect(claudeSpec.thinkingLevels).not.toContain("minimal");
+	});
+
+	it("codex: 界面的 off 翻成上游的 none; 不报 minimal (那个型号明确不支持)", () => {
+		expect(codexSpec.thinkingArgs("off")).toEqual(["-c", "model_reasoning_effort=none"]);
+		expect(codexSpec.thinkingArgs("high")).toEqual(["-c", "model_reasoning_effort=high"]);
+		expect(codexSpec.thinkingLevels).not.toContain("minimal");
+	});
+
+	it("档位进得了 argv", () => {
+		expect(claudeSpec.argv("hi", null, "m", "max")).toContain("--effort");
+		expect(codexSpec.argv("hi", null, "m", "low")).toContain("model_reasoning_effort=low");
+		// 不给档位就一个参数都不加 —— 本机开发时用 CLI 自己的默认。
+		expect(claudeSpec.argv("hi", null, "m").join(" ")).not.toContain("--effort");
+		expect(codexSpec.argv("hi", null, "m").join(" ")).not.toContain("model_reasoning_effort");
+	});
+});
diff --git a/tests/unit/cli-engine-sessions.test.ts b/tests/unit/cli-engine-sessions.test.ts
new file mode 100644
index 0000000..01d792e
--- /dev/null
+++ b/tests/unit/cli-engine-sessions.test.ts
@@ -0,0 +1,125 @@
+/**
+ * 会话列表与回放 —— 读的是**别人的磁盘格式**。
+ *
+ * claude / codex 换了目录布局或行格式, 这里会静默失效: 列表变空、回放变空,
+ * 页面一切正常, 看起来像"这个项目就是没有历史"。踩过一次 (macOS 的 /tmp 软链
+ * 让目录名对不上, 列表永远空且不报错)。所以用真文件跑。
+ */
+
+import { mkdtempSync, mkdirSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+let home: string;
+let work: string;
+
+beforeEach(() => {
+	home = mkdtempSync(join(tmpdir(), "cli-home-"));
+	work = mkdtempSync(join(tmpdir(), "cli-work-"));
+	vi.doMock("node:os", async () => {
+		const real = await vi.importActual<typeof import("node:os")>("node:os");
+		return { ...real, homedir: () => home };
+	});
+});
+afterEach(() => {
+	vi.resetModules();
+	vi.doUnmock("node:os");
+});
+
+/** 真实 claude 行的形状 (实测): 对话行夹在一堆内部记账行中间。 */
+function writeClaudeSession(realWork: string, id: string, lines: unknown[]): void {
+	const dir = join(home, ".claude", "projects", realWork.replace(/[/.]/g, "-"));
+	mkdirSync(dir, { recursive: true });
+	writeFileSync(join(dir, `${id}.jsonl`), lines.map((l) => JSON.stringify(l)).join("\n"), "utf8");
+}
+
+const userLine = (text: string) => ({ type: "user", message: { role: "user", content: [{ type: "text", text }] } });
+const asstLine = (text: string) => ({ type: "assistant", message: { role: "assistant", content: [{ type: "text", text }] } });
+
+describe("claude 会话", () => {
+	it("列表带出标题与条数，跳过内部记账行", async () => {
+		const { listClaudeSessions } = await import("../../server/cli/sessions.js");
+		const { realpathSync } = await import("node:fs");
+		writeClaudeSession(realpathSync(work), "s-1", [
+			{ type: "queue-operation" },              // 内部行, 不该计入
+			userLine("第一句"),
+			{ type: "attachment" },                   // 同上
+			asstLine("回答"),
+			{ type: "last-prompt" },
+		]);
+		const out = listClaudeSessions(work);
+		expect(out).toHaveLength(1);
+		expect(out[0]!.path).toBe("s-1");
+		expect(out[0]!.firstMessage).toBe("第一句");
+		expect(out[0]!.messageCount).toBe(2);        // 只数 user/assistant
+	});
+
+	it("回放只出对话内容，内部行一条不出", async () => {
+		const { replayClaudeSession } = await import("../../server/cli/sessions.js");
+		const { realpathSync } = await import("node:fs");
+		writeClaudeSession(realpathSync(work), "s-2", [
+			// **内部记账行也带正文**: 它们在真文件里就是有 content 的 (attachment
+			// 带附件内容、last-prompt 带上一条提示词)。第一版这里写的是空对象,
+			// 于是"没有 content 就跳过"那条兜底替类型判断挡住了 —— 把 type 判断
+			// 整条拆掉, 测试照样全过。断言必须落在**只能靠 type 区分**的数据上。
+			{ type: "file-history-snapshot", message: { role: "user", content: [{ type: "text", text: "快照噪音" }] } },
+			userLine("问"),
+			asstLine("答"),
+			{ type: "last-prompt", message: { role: "user", content: [{ type: "text", text: "提示词噪音" }] } },
+		]);
+		const msgs = replayClaudeSession(work, "s-2");
+		expect(msgs.map((m) => m.role)).toEqual(["user", "assistant"]);
+		expect(msgs.map((m) => (m.content[0] as { text: string }).text)).toEqual(["问", "答"]);
+		expect(msgs).toHaveLength(2);
+	});
+
