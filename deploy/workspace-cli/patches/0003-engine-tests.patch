+			`echo '{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"echo hi","aggregated_output":"","exit_code":null,"status":"in_progress"}}'`,
+			// 注意别在这里写 \n: 假 CLI 跑在 sh(dash) 下, 它的 echo **会展开反斜杠转义**
+			// —— `"HI\n"` 会被拆成两行, JSON 解析失败, 于是 tool_end 根本不产生。
+			// 我第一版就栽在这儿, 查了半天以为是引擎没配对。要多行输出就用 printf。
+			`echo '{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"echo hi","aggregated_output":"HI","exit_code":0,"status":"completed"}}'`,
+			`echo '{"type":"item.completed","item":{"type":"agent_message","text":"跑完了"}}'`,
+			`echo '{"type":"turn.completed","usage":{}}'`,
+		]);
+		done();
+		const msgs = state()?.messages ?? [];
+		const assistant = msgs.find((m) => (m.content ?? []).some((c) => (c as { type?: string }).type === "toolCall"));
+		expect(assistant, "助手消息里没有 toolCall 块 —— 卡片不会出现").toBeTruthy();
+		const call = (assistant!.content ?? []).find((c) => (c as { type?: string }).type === "toolCall") as {
+			id: string; name: string;
+		};
+		expect(call.name).toContain("echo hi");
+
+		const result = msgs.find((m) => (m as { role?: string }).role === "toolResult");
+		expect(result, "没有 toolResult 消息 —— 卡片会永远停在运行中").toBeTruthy();
+		expect((result as { toolCallId?: string }).toolCallId).toBe(call.id);
+		expect((result!.content ?? [])[0]).toMatchObject({ text: "HI" });
+		// started + completed 两条同 id, 卡片只能有一张。
+		const calls = msgs.flatMap((m) => (m.content ?? []).filter((c) => (c as { type?: string }).type === "toolCall"));
+		expect(calls).toHaveLength(1);
+		expect(frames.some((f) => f.type === "tool_status")).toBe(true);
+	});
+
+	it("思考档位: 报的是这个引擎真能给的那几档, 设进去会跟着发参数", async () => {
+		const { state, session, done } = await drive([`echo '{"type":"turn.completed","usage":{}}'`]);
+		done();
+		expect(state()?.availableThinkingLevels).toEqual(["off", "low", "medium", "high", "xhigh", "max"]);
+		expect(state()?.thinkingLevel).toBe("medium");
+		const s2 = session as unknown as { setThinking(l: string): void };
+		// 不认识的档位不许"假装设上了" —— minimal 那个型号明确不支持。
+		s2.setThinking("minimal");
+		expect(state()?.thinkingLevel).toBe("medium");
+		s2.setThinking("xhigh");
+		expect(state()?.thinkingLevel).toBe("xhigh");
+	});
+
+	it("改写重问: 那条之后的全部丢掉, 不留着旧回答", async () => {
+		const { session, state, done } = await drive([
+			`echo '{"type":"item.completed","item":{"type":"agent_message","text":"第一次的回答"}}'`,
+			`echo '{"type":"turn.completed","usage":{}}'`,
+		]);
+		try {
+			const before = state()?.messages ?? [];
+			expect(before.map((m) => (m as { role?: string }).role)).toContain("assistant");
+			const userMsg = before.find((m) => (m as { role?: string }).role === "user") as { id: string };
+
+			// **假 CLI 还要留在 PATH 上** —— editMessage 会再跑一轮。
+			await (session as unknown as { editMessage(id: string, t: string): Promise<void> }).editMessage(
+				userMsg.id,
+				"改过的问题",
+			);
+			const after = (state()?.messages ?? []) as { role?: string; content?: { text?: string }[] }[];
+			// 判据落在**提问**上, 不是回答 —— 假 CLI 每轮吐的是同一句话, 拿回答当
+			// 判据等于问了一道答案必然出现在题面里的题。
+			const asked = after.filter((m) => m.role === "user").flatMap((m) => (m.content ?? []).map((c) => c.text));
+			expect(asked).toEqual(["改过的问题"]);
+		} finally {
+			done();
+		}
+	}, 20_000);
+});
