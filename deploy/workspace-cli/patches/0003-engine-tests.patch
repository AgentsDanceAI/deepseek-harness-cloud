+// @vitest-environment jsdom
+/**
+ * 实例默认皮肤 (PI_WEB_DEFAULT_THEME 由服务端烧进首帧) 与用户自己的选择, 谁赢。
+ *
+ * 这条线上有一个**容易丢用户设置**的坑: "选回默认深色"原来走 removeItem, 而
+ * removeItem 之后下次开就又被实例默认皮肤接管 —— 用户明明选了深色, 第二天打开
+ * 还是赛博朋克, 而且他再选一次还是不管用。所以默认深色也要写下来。
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const KEY = "pi-web-ui:theme";
+const setBootDefault = (v: string | undefined) => {
+	const w = window as unknown as { __PI_DEFAULT_THEME__?: string };
+	if (v === undefined) delete w.__PI_DEFAULT_THEME__;
+	else w.__PI_DEFAULT_THEME__ = v;
+};
+
+describe("默认皮肤 vs 用户选择", () => {
+	beforeEach(() => {
+		localStorage.clear();
+		vi.resetModules();
+		setBootDefault("cyberpunk");
+	});
+	afterEach(() => {
+		setBootDefault(undefined);
+		localStorage.clear();
+	});
+
+	it("没选过: 用实例默认", async () => {
+		const { loadTheme } = await import("../../web/src/theme");
+		expect(loadTheme()).toBe("cyberpunk");
+	});
+
+	it("选过别的: 用户赢", async () => {
+		localStorage.setItem(KEY, "white");
+		const { loadTheme } = await import("../../web/src/theme");
+		expect(loadTheme()).toBe("white");
+	});
+
+	it("显式选回深色: 也要赢, 不能被实例默认顶回去", async () => {
+		const { saveTheme, loadTheme } = await import("../../web/src/theme");
+		saveTheme(null);
+		expect(localStorage.getItem(KEY)).toBe("dark");
+		expect(loadTheme()).toBeNull();
+	});
+
+	it("没配实例默认: 还是打包的深色", async () => {
+		setBootDefault(undefined);
+		const { loadTheme } = await import("../../web/src/theme");
+		expect(loadTheme()).toBeNull();
+	});
+
+	it("实例默认就是 dark: 等价于不配", async () => {
+		setBootDefault("dark");
+		const { loadTheme } = await import("../../web/src/theme");
+		expect(loadTheme()).toBeNull();
+	});
+});
