+/**
+ * 上面钉的是 terminalEnv 这个函数本身。这一条钉的是**终端真的用上了它** ——
+ * 两者不是一回事: 把 shellEnv 改回 `...process.env`, 上面那几条照样全绿, 而
+ * 用户在终端里敲 claude 照样要登录。所以这里起一个真 PTY 去问它。
+ */
+describe("终端里真的能看到那几个变量", () => {
+	it("PTY 里 echo 得出网关地址", async () => {
+		process.env.DSH_GATEWAY_BASE = GW;
+		process.env.DSH_CLOUD_TOKEN = TOK;
+		vi.resetModules();
+		const { TerminalManager } = await import("../../server/terminals.js");
+		const { mkdtempSync } = await import("node:fs");
+		const { tmpdir } = await import("node:os");
+		const { join } = await import("node:path");
+
+		const cwd = mkdtempSync(join(tmpdir(), "pi-term-env-"));
+		const mgr = new TerminalManager(() => {}, cwd);
+		expect(mgr.create("t-env", cwd, 80, 24, cwd)).not.toBeNull();
+		try {
+			mgr.input("t-env", "echo GW=$ANTHROPIC_BASE_URL\r");
+			const deadline = Date.now() + 15_000;
+			let out = "";
+			while (Date.now() < deadline) {
+				out = mgr.read("t-env", 0, 200_000)?.data ?? "";
+				// 回显里也有这串字面量, 所以要等**展开后**的那一行。
+				if (out.includes(`GW=${GW}/llm/anthropic`)) break;
+				await new Promise((r) => setTimeout(r, 100));
+			}
+			expect(out).toContain(`GW=${GW}/llm/anthropic`);
+		} finally {
+			mgr.kill("t-env");
+		}
+	}, 30_000);
+});
+
+/**
+ * 子进程的 stdin 必须关掉 —— 用一个**假 CLI** 验, 不花钱也不碰网络。
+ *
+ * 假 codex 的第一件事是 `cat > /dev/null`: 读到 EOF 才往下走。引擎不关 stdin
+ * 的话它就永远卡在那儿 —— 与真 codex 的 `Reading additional input from
+ * stdin...` 同一个形状 (2026-09-11 老板实拍: "正在思考"转到天荒地老)。
+ */
+describe("引擎必须关掉子进程的 stdin", () => {
+	it("prompt 一轮能跑完并拿到正文", async () => {
+		const { mkdtempSync, writeFileSync, chmodSync } = await import("node:fs");
+		const { tmpdir } = await import("node:os");
+		const { join } = await import("node:path");
+		const { CliSession } = await import("../../server/cli/cli-session.js");
+
+		const bin = mkdtempSync(join(tmpdir(), "pi-fakecli-"));
+		const cwd = mkdtempSync(join(tmpdir(), "pi-fakecwd-"));
+		const fake = join(bin, "codex");
+		writeFileSync(
+			fake,
+			[
+				"#!/bin/sh",
+				"cat > /dev/null", // 没有 EOF 就卡死在这里
+				'echo \'{"type":"thread.started","thread_id":"t1"}\'',
+				'echo \'{"type":"item.completed","item":{"type":"agent_message","text":"喵"}}\'',
+				'echo \'{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}\'',
+				"",
+			].join("\n"),
+			"utf8",
+		);
+		chmodSync(fake, 0o755);
+
+		const savedPath = process.env.PATH;
+		process.env.PATH = `${bin}:${savedPath}`;
+		try {
+			let last: Snap | null = null;
+			const session = new CliSession("c1", cwd, "codex", (msg: { type: string; state?: unknown }) => {
+				if (msg.type === "snapshot") last = msg.state as Snap;
+			});
+			// 不关 stdin 的话这里永远不返回 —— 用例会超时, 而那正是线上的症状。
+			await session.prompt("说句话");
+			const texts = ((last as Snap | null)?.messages ?? []).flatMap((m) =>
+				(m.content ?? []).map((c) => c.text ?? ""),
+			);
+			expect(texts.join("")).toContain("喵");
+		} finally {
+			process.env.PATH = savedPath;
+		}
+	}, 20_000);
+});
+
+/**
+ * 「转圈停了、页面上什么也没多出来」那一类。两条都是**退出码 0** 的:
+ * CLI 认为自己正常结束, 只是没吐正文。原来这两种都被静静吞掉。
+ */
+describe("没有正文的那一轮也要留下话", () => {
+	async function runFake(lines: string[]) {
+		const { mkdtempSync, writeFileSync, chmodSync } = await import("node:fs");
+		const { tmpdir } = await import("node:os");
+		const { join } = await import("node:path");
+		const { CliSession } = await import("../../server/cli/cli-session.js");
+
+		const bin = mkdtempSync(join(tmpdir(), "pi-fakecli-"));
+		const cwd = mkdtempSync(join(tmpdir(), "pi-fakecwd-"));
+		const fake = join(bin, "codex");
+		writeFileSync(fake, ["#!/bin/sh", "cat > /dev/null", ...lines, "exit 0", ""].join("\n"), "utf8");
+		chmodSync(fake, 0o755);
+
+		const savedPath = process.env.PATH;
+		process.env.PATH = `${bin}:${savedPath}`;
+		const notices: string[] = [];
+		let last: Snap | null = null;
+		try {
+			const session = new CliSession(
+				"c1",
+				cwd,
+				"codex",
+				(msg: { type: string; state?: unknown; text?: string }) => {
+					if (msg.type === "snapshot") last = msg.state as Snap;
+					if (msg.type === "notice") notices.push(String(msg.text ?? ""));
+				},
+			);
+			await session.prompt("说句话");
+		} finally {
+			process.env.PATH = savedPath;
+		}
+		return { notices, messages: (last as Snap | null)?.messages ?? [] };
+	}
+
+	it("CLI 自己报的错要弹出来, 并且当成这一轮的结论", async () => {
+		const { notices, messages } = await runFake([
+			`echo '{"type":"item.completed","item":{"type":"error","message":"Model metadata for x not found"}}'`,
+		]);
+		expect(notices.join("")).toContain("Model metadata");
+		expect(messages.at(-1)?.errorMessage).toContain("Model metadata");
+	}, 20_000);
+
+	it("什么都没吐又退出 0: 也要说一句, 别让页面空着", async () => {
+		const { messages } = await runFake([`echo '{"type":"turn.completed","usage":{}}'`]);
+		expect(messages.at(-1)?.errorMessage).toContain("没有任何输出");
+	}, 20_000);
+
+	it("用户自己按停的那一轮不算故障, 不留错误条", async () => {
+		const { mkdtempSync, writeFileSync, chmodSync } = await import("node:fs");
+		const { tmpdir } = await import("node:os");
+		const { join } = await import("node:path");
+		const { CliSession } = await import("../../server/cli/cli-session.js");
+
+		const bin = mkdtempSync(join(tmpdir(), "pi-fakecli-"));
+		const cwd = mkdtempSync(join(tmpdir(), "pi-fakecwd-"));
+		const fake = join(bin, "codex");
+		// 一句话不说, 就耗着 —— 等着被 abort。**exec** 很关键: 不 exec 的话
+		// SIGTERM 只打到 sh, 被孤儿化的 sleep 还攥着 stdout 管道, 于是 close
+		// 事件要等它自己睡完才来 (node 的 close 等的是全部 stdio 关闭, 不是进程退出)。
+		writeFileSync(fake, ["#!/bin/sh", "cat > /dev/null", "exec sleep 30", ""].join("\n"), "utf8");
+		chmodSync(fake, 0o755);
+
+		const savedPath = process.env.PATH;
+		process.env.PATH = `${bin}:${savedPath}`;
+		let last: Snap | null = null;
+		try {
+			const session = new CliSession("c1", cwd, "codex", (msg: { type: string; state?: unknown }) => {
+				if (msg.type === "snapshot") last = msg.state as Snap;
+			});
+			const turn = session.prompt("说句话");
+			await new Promise((r) => setTimeout(r, 400));
+			await session.abort();
+			await turn;
+		} finally {
+			process.env.PATH = savedPath;
+		}
+		const errs = ((last as Snap | null)?.messages ?? []).map((m) => m.errorMessage).filter(Boolean);
+		expect(errs).toEqual([]);
+	}, 20_000);
+});
