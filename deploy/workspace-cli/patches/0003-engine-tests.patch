new file mode 100644
index 0000000..3bae3f9
--- /dev/null
+++ b/tests/cli-engine-brand-test.mjs
@@ -0,0 +1,103 @@
+/**
+ * 第三个引擎的两件「开机就该对」的事 —— 都必须**真起一次 server** 才测得出。
+ *
+ *   1. 首页发出去的 HTML 里就带着引擎名 (标题 + window.__PI_ENGINE_NAME__)。
+ *      不带的话左上角先画「π pi-web-ui」, WebSocket 的 ready 帧到了才跳成
+ *      「C Claude Code」—— 用户第一眼看到的是另一个产品名一闪而过。
+ *      **这条非得真发一次请求**: 我第一版在 catch-all 里做了烧字, 单测全绿,
+ *      而 `/` 根本走不到那里 —— express.static 的 index 选项默认会把
+ *      index.html 直接发掉。深链接生效、首页不生效, 只有 curl 一下看得见。
+ *   2. codex 的 config.toml 开机就写好, 不等对话面板先跑一轮 —— 否则用户开完
+ *      工作台直接进 [终端] 敲 codex, 它去问用户要 OpenAI 的登录。
+ *
+ * 外加一条反向的: 上游引擎 (pi) 发出去的 HTML 必须与磁盘上的文件**逐字节相同**。
+ */
+import { portUp, freePort } from "./lib/port-utils.mjs";
+import { fileURLToPath } from "node:url";
+import { execSync, spawn } from "node:child_process";
+import { mkdtempSync, readFileSync, existsSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setTimeout as sleep } from "node:timers/promises";
+
+const REPO_ROOT = fileURLToPath(new globalThis.URL("../", import.meta.url));
+const GW = "https://aistore.best";
+
+let failures = 0;
+const check = (name, ok, extra = "") => {
+	console.log(`${ok ? "✓" : "✗"} ${name}${extra ? " — " + extra : ""}`);
+	if (!ok) failures++;
+};
+
+try {
+	execSync("npm run build", { cwd: REPO_ROOT, stdio: "ignore" });
+} catch {
+	console.error("build failed");
+	process.exit(1);
+}
+
+/** 起一个 server, 跑 fn, 收尾。HOME 指到临时目录 —— 这个测试会写 ~/.codex。 */
+async function withServer(port, env, fn) {
+	try {
+		await freePort(port);
+	} catch {}
+	await sleep(300);
+	const home = mkdtempSync(join(tmpdir(), "pi-brand-home-"));
+	const srv = spawn("node", ["dist/server/index.js"], {
+		cwd: REPO_ROOT,
+		env: { ...process.env, HOME: home, USERPROFILE: home, PI_WEB_PORT: String(port), ...env },
+		stdio: ["ignore", "ignore", "ignore"],
+	});
+	try {
+		for (let i = 0; i < 80 && !(await portUp(port)); i++) await sleep(250);
+		if (!(await portUp(port))) throw new Error(`server 起不来 (:${port})`);
+		await fn({ home, base: `http://127.0.0.1:${port}` });
+	} finally {
+		srv.kill("SIGKILL");
+		await sleep(200);
+	}
+}
+
+const DIST_INDEX = join(REPO_ROOT, "web", "dist", "index.html");
+
+try {
+	await withServer(
+		8907,
+		{ PI_WEB_ENGINE: "codex", DSH_GATEWAY_BASE: GW, DSH_CLOUD_TOKEN: "tok-test" },
+		async ({ home, base }) => {
+			const root = await (await fetch(`${base}/`)).text();
+			check("首页标题就是引擎名", root.includes("<title>Codex</title>"), root.slice(0, 400));
+			check("首页不再出现 pi-web-ui", !root.includes("pi-web-ui"));
+			check("首帧回落值发下去了", root.includes('window.__PI_ENGINE_NAME__="Codex"'));
+			check("在 </head> 之前", root.indexOf("__PI_ENGINE_NAME__") < root.indexOf("</head>"));
+
+			const deep = await (await fetch(`${base}/whatever/deep`)).text();
+			check("深链接同样带名字", deep.includes('window.__PI_ENGINE_NAME__="Codex"'));
+
+			const icon = await fetch(`${base}/favicon.svg`);
+			check("静态资源照常发 (index:false 没有伤到 static)", icon.status === 200);
+
+			const toml = join(home, ".codex", "config.toml");
+			check("开机就写好了 codex 的 config.toml", existsSync(toml));
+			if (existsSync(toml)) {
+				const body = readFileSync(toml, "utf8");
+				check("指向我们的网关", body.includes(`base_url = "${GW}/llm/v1"`), body);
+				// codex 0.151 起不认 chat 面。
+				check("wire_api 是 responses", body.includes('wire_api = "responses"'));
+			}
+		},
+	);
+
+	// 反向: 上游引擎一个字节都不许变。
+	await withServer(8908, { PI_WEB_ENGINE: "pi" }, async ({ home, base }) => {
+		const root = await (await fetch(`${base}/`)).text();
+		check("pi 引擎: 与磁盘上的 index.html 逐字节相同", root === readFileSync(DIST_INDEX, "utf8"));
+		check("pi 引擎: 不塞任何全局变量", !root.includes("__PI_ENGINE_NAME__"));
+		check("pi 引擎: 不写 codex 的 config.toml", !existsSync(join(home, ".codex", "config.toml")));
+	});
+} catch (e) {
+	check("测试跑完", false, String(e));
+}
+
+console.log(failures ? `\n${failures} 条失败` : "\n全部通过");
+process.exit(failures ? 1 : 0);
