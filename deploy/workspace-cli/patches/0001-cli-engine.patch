diff --git a/server/cli/branding.ts b/server/cli/branding.ts
new file mode 100644
index 0000000..b6be465
--- /dev/null
+++ b/server/cli/branding.ts
@@ -0,0 +1,39 @@
+/**
+ * branding.ts —— 把引擎名烧进发出去的 HTML。
+ *
+ * 为什么不能只靠 `ready` 帧: engineName 是 WebSocket 连上之后才到的, 在那之前
+ * 前端已经画完第一帧了 —— 左上角先出「π pi-web-ui」, 连上再跳成「C Claude
+ * Code」, 标签页标题同理。用户第一眼看到的是**另一个产品名**闪一下再被盖掉
+ * (老板 2026-09-11: "左上角先出现 pi-web-ui, 再叠加的 claude code, 合适吗")。
+ *
+ * 这份是纯函数, 好让它能被直接钉住 —— server/index.ts 只管读文件和缓存。
+ */
+
+/** HTML 文本节点里的转义。名字来自我们自己的白名单, 但它是拼进 HTML 的, 按
+ *  不可信处理不花钱。 */
+function escapeHtml(s: string): string {
+	return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+}
+
+/**
+ * 把 `<title>` 换成引擎名, 并在 `</head>` 前塞一行 `window.__PI_ENGINE_NAME__`
+ * (前端的首帧回落值, 见 web/src/boot-engine-name.ts)。
+ *
+ * engineName 为空 (pi / dsh 两个上游引擎) 时**原样返回** —— 上游发出去的字节
+ * 一个都不该变。
+ */
+export function brandIndexHtml(raw: string, engineName: string, defaultTheme = ""): string {
+	if (!engineName && !defaultTheme) return raw;
+	// JSON.stringify 管引号和反斜杠, `<` 再转一手 —— 否则值里一个 </script>
+	// 就能提前关掉这个标签。
+	const lit = (v: string) => JSON.stringify(v).replace(/</g, "\\u003c");
+	const globals = [
+		engineName ? `window.__PI_ENGINE_NAME__=${lit(engineName)};` : "",
+		// 默认皮肤也要**烧进首帧**: 它走 <link> 注入, 晚一拍就是先画一屏默认深色
+		// 再整页换色。用户自己选过就以 localStorage 为准 (见 web/src/theme.ts)。
+		defaultTheme ? `window.__PI_DEFAULT_THEME__=${lit(defaultTheme)};` : "",
+	].join("");
+	let out = raw.replace("</head>", `\t\t<script>${globals}</script>\n\t</head>`);
+	if (engineName) out = out.replace(/<title>[^<]*<\/title>/, `<title>${escapeHtml(engineName)}</title>`);
+	return out;
+}
diff --git a/server/cli/cli-adapter.ts b/server/cli/cli-adapter.ts
new file mode 100644
index 0000000..00b8c4e
--- /dev/null
+++ b/server/cli/cli-adapter.ts
@@ -0,0 +1,287 @@
+/**
+ * cli-adapter.ts —— 把 CLI 的 JSON 行归一成同一套事件。
+ *
+ * 这一层是**从 AI Store 的自研工作台移植过来的** (deploy/workspace-agentui/
+ * app/adapters.py)。那边的注释写着"每个 schema 都是实测抓出来的, 不是照文档
+ * 写的" —— 所以这里照抄形状, 不重新猜。
+ *
+ * 与 dsh 引擎的区别: DSH 的 SDK 是个库, 要另搭一个 JSON-RPC 运行时壳
+ * (server/dsh/runtime/, 973 行); claude 与 codex 本来就往 stdout 吐 JSON,
+ * 直接 spawn 就行。
+ */
+
+export type CliEvent =
+	| { t: "session"; id: string }
+	| { t: "delta"; text: string }
+	| { t: "text"; text: string }
+	| { t: "thinking"; text: string }
+	| { t: "tool"; id: string; name: string; input: unknown }
+	| { t: "tool_args"; id: string; delta: string }
+	| { t: "tool_end"; id: string; ok: boolean; output: string }
+	| { t: "done"; usage: { input: number; output: number; cacheRead: number } }
+	| { t: "error"; message: string }
+	| { t: "raw"; line: string };
+
+export interface CliSpec {
+	readonly id: "claude" | "codex";
+	readonly name: string;
+	/**
+	 * 这个 CLI **真能给**的思考档位, 以及开箱默认那一档。
+	 *
+	 * 界面那套词表是 off/minimal/low/medium/high/xhigh/max, 但两个 CLI 谁都不是
+	 * 全都收 —— 只报自己真能给的, 界面就只显示这几档。**宁可少一档, 不给一个点了
+	 * 没反应的**。都是实测出来的:
+	 *   claude 2.1.193 `--effort` 只认 low|medium|high|xhigh|max; 传 off/minimal
+	 *     它会 `Warning: Unknown --effort value … ignoring it`, 然后照默认跑。
+	 *   codex 侧 `-c model_reasoning_effort=` 在**本地不校验**(连 bogus 都收),
+	 *     真正把关的是模型: 经我们网关实测 gpt-5.6-luna 收 none/low/medium/high/
+	 *     xhigh/max, 而 `minimal` 回 400 "not supported with this model"。
+	 */
+	readonly thinkingLevels: readonly string[];
+	readonly defaultThinking: string;
+	/** 这一档对应的命令行参数。空数组 = 这一档不用加参数。 */
+	thinkingArgs(level: string): string[];
+	/** 起一轮对话的 argv。resume 为空表示新会话。 */
+	argv(prompt: string, resume: string | null, model: string, thinking?: string): string[];
+	/** prompt 走 stdin 还是 argv。 */
+	readonly stdinPrompt: boolean;
+	stdinPayload(prompt: string): string | null;
+	feed(line: string): CliEvent[];
+}
+
+const num = (v: unknown): number => (typeof v === "number" ? v : 0);
+
+/** claude 的工具参数是按 content block 的 index 流式给的, 而结果里只有 toolCallId
+ *  —— 这张表把两者对上。进程级别的 Map 足够: 一个进程一轮, index 不会跨轮复用。 */
+const claudeToolIndex = new Map<number, string>();
+
+/** tool_result 的 content 可能是字符串, 也可能是 block 数组。 */
+function blockText(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	return content
+		.map((c: any) => (typeof c === "string" ? c : c?.type === "text" ? (c.text ?? "") : ""))
+		.filter(Boolean)
+		.join("\n");
+}
+
+/** reasoning 的 summary[] -> 文本。元素是 {type:"summary_text", text} 或直接字符串。 */
+function summaryText(summary: unknown): string {
+	if (!Array.isArray(summary)) return "";
+	return summary
+		.map((x: any) => (typeof x === "string" ? x : (x?.text ?? "")))
+		.filter(Boolean)
+		.join("\n");
+}
+
+/** codex 里算"工具"的那几种 item。 */
+const CODEX_TOOL_ITEMS = ["command_execution", "file_change", "tool_call", "mcp_tool_call", "web_search"];
+
+/** 卡片标题: 命令执行就显示命令本身, 比清一色的 command_execution 有用得多。 */
+function codexToolName(it: any): string {
+	if (it?.type === "command_execution" && it.command) return String(it.command).slice(0, 120);
+	return String(it?.tool_name ?? it?.name ?? it?.type ?? "?");
+}
+
+/** Claude Code: 双向 stream-json, 三个里最完整的一个。 */
+export const claudeSpec: CliSpec = {
+	id: "claude",
+	name: "Claude Code",
+	stdinPrompt: true,
+	// 抓包看到的: 不传 --effort 时它自己就按 high 发 (output_config.effort=high),
+	// 所以默认值取 high —— 界面显示的那一档与它真实的行为对得上。
+	thinkingLevels: ["low", "medium", "high", "xhigh", "max"],
+	defaultThinking: "high",
+	thinkingArgs(level) {
+		return level ? ["--effort", level] : [];
+	},
+	argv(_prompt, resume, model, thinking) {
+		const a = [
+			"--print",
+			"--input-format", "stream-json",
+			"--output-format", "stream-json",
+			"--include-partial-messages",
+			"--verbose",
+			"--dangerously-skip-permissions",
+		];
+		if (model) a.push("--model", model);
+		if (resume) a.push("--resume", resume);
+		if (thinking) a.push(...claudeSpec.thinkingArgs(thinking));
+		return a;
+	},
+	stdinPayload(prompt) {
+		return (
+			JSON.stringify({
+				type: "user",
+				message: { role: "user", content: [{ type: "text", text: prompt }] },
+			}) + "\n"
+		);
+	},
+	feed(line) {
+		let e: Record<string, any>;
+		try {
+			e = JSON.parse(line);
+		} catch {
+			return [{ t: "raw", line }];
+		}
+		if (e.type === "system" && e.subtype === "init") return [{ t: "session", id: String(e.session_id ?? "") }];
+		if (e.type === "stream_event") {
+			const ev = e.event ?? {};
+			const d = ev.delta;
+			if (d?.type === "text_delta") return [{ t: "delta", text: String(d.text ?? "") }];
+			if (d?.type === "thinking_delta") return [{ t: "thinking", text: String(d.thinking ?? "") }];
+			// 工具调用: content_block_start 带 tool_use。**必须出事件** —— 一轮里
+			// 如果全是工具活动 (模型先派 Explore 子智能体再回答), 界面上一个字都
+			// 不动, 看着就是卡死。实测踩过: 真模型问"读一下 fib.py", 它先起子
+			// 智能体探索, 界面停在「正在思考」二十多秒, 其实一直在干活。
+			const cb = ev.content_block;
+			if (ev.type === "content_block_start" && cb?.type === "tool_use") {
+				// 参数是随后用 input_json_delta 一片一片给的, 这里 input 还是 {}。
+				// 记下 index -> toolCallId 的对应, 好把后面的片段贴到正确的卡片上。
+				claudeToolIndex.set(Number(ev.index ?? -1), String(cb.id ?? ""));
+				return [{ t: "tool", id: String(cb.id ?? ""), name: String(cb.name ?? "?"), input: cb.input }];
+			}
+			if (d?.type === "input_json_delta") {
+				const id = claudeToolIndex.get(Number(ev.index ?? -1));
+				if (!id) return [];
+				return [{ t: "tool_args", id, delta: String(d.partial_json ?? "") }];
+			}
+			if (ev.type === "content_block_stop") {
+				claudeToolIndex.delete(Number(ev.index ?? -1));
+				return [];
+			}
+			return [];
+		}
+		// 工具**结果**走的是一条 type="user" 的行 (里面是 tool_result 块) ——
+		// 实测抓到的原文:
+		//   {"type":"user","message":{"role":"user","content":[
+		//     {"tool_use_id":"toolu_…","type":"tool_result","content":"HELLO-TOOL",
+		//      "is_error":false}]}}
+		// **千万别把它当成用户发言**: 那样界面上会凭空多出一条"用户说了工具输出"。
+		if (e.type === "user" && Array.isArray(e.message?.content)) {
+			const out: CliEvent[] = [];
+			for (const c of e.message.content as any[]) {
+				if (c?.type !== "tool_result") continue;
+				out.push({
+					t: "tool_end",
+					id: String(c.tool_use_id ?? ""),
+					ok: c.is_error !== true,
+					output: blockText(c.content),
+				});
+			}
+			return out;
+		}
+		// **不收 type=\"assistant\" 的整段正文**: 开着 --include-partial-messages 时
+		// 它与 text_delta 是同一份内容的两种给法, 两个都收正文会翻倍。
+		// 实测 (走 AI Store 网关): claude-sonnet-5 两边都是「你好世界」;
+		// gpt-5.6-luna 的 assistant 行甚至是「你好世界你好世界」(分两条给)。
+		if (e.type === "result") {
+			const u = e.usage ?? {};
+			return [
+				{
+					t: "done",
+					usage: {
+						input: num(u.input_tokens),
+						output: num(u.output_tokens),
+						cacheRead: num(u.cache_read_input_tokens),
+					},
+				},
+			];
+		}
+		return [{ t: "raw", line }];
+	},
+};
+
+/** Codex: `codex exec --json`, 单向 JSONL。**没有流式增量** —— 正文是一整段
+ *  item.completed 给的, 所以走 "text" 而不是 "delta"。 */
+export const codexSpec: CliSpec = {
+	id: "codex",
+	name: "Codex",
+	stdinPrompt: false,
+	// 界面那档叫 off, 上游的写法是 none —— 在这里翻译, 别让界面去认两套词。
+	// **不报 minimal**: gpt-5.6-luna 明确回 400 说这个模型不支持。
+	thinkingLevels: ["off", "low", "medium", "high", "xhigh", "max"],
+	defaultThinking: "medium",
+	thinkingArgs(level) {
+		if (!level) return [];
+		return ["-c", `model_reasoning_effort=${level === "off" ? "none" : level}`];
+	},
+	argv(prompt, resume, model, thinking) {
+		const a = ["exec", "--json", "--skip-git-repo-check", "--sandbox", "danger-full-access"];
+		if (model) a.push("-m", model);          // 按次指定 —— dsh 引擎做不到这点
+		if (thinking) a.push(...codexSpec.thinkingArgs(thinking));
+		if (resume) a.push("resume", resume);
+		a.push(prompt);
+		return a;
+	},
+	stdinPayload() {
+		return null;
+	},
+	feed(line) {
+		let e: Record<string, any>;
+		try {
+			e = JSON.parse(line);
+		} catch {
+			return [{ t: "raw", line }];
+		}
+		if (e.type === "thread.started") return [{ t: "session", id: String(e.thread_id ?? "") }];
+		// codex 的工具是**两条**: item.started (in_progress, 还没输出) 与
+		// item.completed (带 aggregated_output 与 exit_code)。实测原文:
+		//   {"type":"item.started","item":{"id":"item_1","type":"command_execution",
+		//     "command":"/bin/bash -lc 'echo HELLO-TOOL'","aggregated_output":"",
+		//     "exit_code":null,"status":"in_progress"}}
+		// 先出卡片再补结果 —— 命令要跑很久时, 用户得看得见"它在跑什么"。
+		if (e.type === "item.started" && CODEX_TOOL_ITEMS.includes(e.item?.type)) {
+			const it = e.item;
+			return [{ t: "tool", id: String(it.id ?? ""), name: codexToolName(it), input: it }];
+		}
+		if (e.type === "item.completed") {
+			const it = e.item ?? {};
+			if (it.type === "agent_message") return [{ t: "text", text: String(it.text ?? "") }];
+			if (it.type === "reasoning") {
+				// 两种形状都见过: 有的版本直接给 `text`, 会话文件里则是
+				// `summary: [{type:"summary_text", text}]`。只认 text 的话思考是空的
+				// —— 界面上有个思考块但一个字没有, 比不显示更让人以为是坏了。
+				const text = String(it.text ?? "") || summaryText(it.summary);
+				return text ? [{ t: "thinking", text }] : [];
+			}
+			if (CODEX_TOOL_ITEMS.includes(it.type)) {
+				// 没见过 started 的 (旧版本只发 completed) 也要先补一张卡片, 否则
+				// 结果贴不到任何卡片上 —— 两条一起出, 下游按 id 合并。
+				return [
+					{ t: "tool", id: String(it.id ?? ""), name: codexToolName(it), input: it },
+					{
+						t: "tool_end",
+						id: String(it.id ?? ""),
+						ok: it.exit_code === 0 || it.exit_code === null || it.exit_code === undefined,
+						output: String(it.aggregated_output ?? it.output ?? ""),
+					},
+				];
+			}
+			// codex 把一部分错误当成**一个 item** 发, 不走 turn.failed。实测抓到的
+			// 一条: `Model metadata for \`claude-fable-5\` not found. Defaulting to
+			// fallback metadata; …` —— 原来这里没接, 于是它掉进最后那个 raw 里,
+			// 被彻底丢掉: 型号不对的那一轮界面上一句话都没有。
+			if (it.type === "error") return [{ t: "error", message: String(it.message ?? JSON.stringify(it).slice(0, 400)) }];
+		}
+		if (e.type === "turn.completed") {
+			const u = e.usage ?? {};
+			return [
+				{
+					t: "done",
+					usage: {
+						input: num(u.input_tokens),
+						output: num(u.output_tokens),
+						cacheRead: num(u.cached_input_tokens),
+					},
+				},
+			];
+		}
+		if (e.type === "turn.failed" || e.type === "error") {
+			return [{ t: "error", message: JSON.stringify(e).slice(0, 400) }];
+		}
+		return [{ t: "raw", line }];
+	},
+};
+
+export const SPECS: Record<string, CliSpec> = { claude: claudeSpec, codex: codexSpec };
diff --git a/server/cli/cli-agent-service.ts b/server/cli/cli-agent-service.ts
new file mode 100644
index 0000000..8e57609
--- /dev/null
+++ b/server/cli/cli-agent-service.ts
@@ -0,0 +1,86 @@
+/**
+ * cli-agent-service.ts —— 第三个引擎的连接管理器 (PI_WEB_ENGINE=claude|codex)。
+ *
+ * EngineService 只有十六个必需方法, 它管的是**连接**, 不是会话本身 ——
+ * 真正的面在 attach() 返回的 DispatchSession 上 (见 cli-session.ts)。
+ *
+ * 骨架阶段: 每个 clientId 一个会话, 不做静默期 (quiesce) 的排队语义 ——
+ * 那是给"服务端要重启但别掐断用户"用的, 等这条路确定要走再补。
+ */
+
+import type { EngineService } from "../index.js";
+import type { ServerMessage } from "../protocol.js";
+import { CliSession } from "./cli-session.js";
+
+export class CliAgentService implements EngineService {
+	private readonly clients = new Map<string, CliSession>();
+	private sockets = 0;
+	private quiesced = false;
+	private quiescedSince: number | undefined;
+
+	constructor(
+		private readonly cwd: string,
+		private readonly engine: string,
+		private readonly version: string,
+	) {}
+
+	async attach(clientId: string, send: (msg: ServerMessage) => void): Promise<CliSession> {
+		let cs = this.clients.get(clientId);
+		if (!cs) {
+			cs = new CliSession(clientId, this.cwd, this.engine, send);
+			this.clients.set(clientId, cs);
+		}
+		// 首屏: 先把快照推过去, 否则前端停在空白等状态。
+		cs.snapshot();
+		// **型号要在第一轮对话之前就定下来。** 前端是等面板打开才发 list_models 的,
+		// 而用户完全可能一上来就发消息 —— 那时 this.model 还是空, 等于没给 --model,
+		// 于是落到 CLI 自己的默认型号, 而网关只放行在售目录, 结果是一发就 404。
+		// 拉目录是异步的, 不挡 attach; 拉完会自己再推一次快照。
+		void cs.listModels();
+		return cs;
+	}
+
+	detach(clientId: string, _send: (msg: ServerMessage) => void): void {
+		this.clients.delete(clientId);
+	}
+
+	get(clientId: string): CliSession | undefined {
+		return this.clients.get(clientId);
+	}
+
+	async disposeAll(): Promise<void> {
+		for (const cs of this.clients.values()) await cs.abort();
+		this.clients.clear();
+	}
+
+	noteSocketOpen(): void { this.sockets++; }
+	noteSocketClose(): void { this.sockets = Math.max(0, this.sockets - 1); }
+	isQuiesced(): boolean { return this.quiesced; }
+	quiesce(): void { this.quiesced = true; this.quiescedSince = Date.now(); }
+	unquiesce(): void { this.quiesced = false; this.quiescedSince = undefined; }
+	quiesceInfo(): { quiesced: boolean; quiescedSince?: number } {
+		return this.quiescedSince === undefined
+			? { quiesced: this.quiesced }
+			: { quiesced: this.quiesced, quiescedSince: this.quiescedSince };
+	}
+
+	serviceStatus() {
+		return {
+			pid: process.pid,
+			version: this.version,
+			cwd: this.cwd,
+			quiesced: this.quiesced,
+			...(this.quiescedSince === undefined ? {} : { quiescedSince: this.quiescedSince }),
+			connectedClients: this.sockets,
+			activeConversations: this.activeConversations(),
+			pendingMessages: 0,
+		};
+	}
+
+	activeConversations(): number { return this.clients.size; }
+	pendingMessages(): number { return 0; }
+	applyPluginAgentTools(): void {}
+	applyPluginCommandCatalog(): void {}
+	refreshBackgroundServers(): void {}
+	async setLocale(_clientId: string, _locale: string): Promise<void> {}
+}
diff --git a/server/cli/cli-session.ts b/server/cli/cli-session.ts
new file mode 100644
index 0000000..7f2da6a
--- /dev/null
+++ b/server/cli/cli-session.ts
@@ -0,0 +1,619 @@
+/**
+ * cli-session.ts —— 第三个引擎的会话对象 (PI_WEB_ENGINE=claude|codex)。
+ *
+ * **这是一个能走路的骨架, 不是完整引擎。** 只把聊天那一条链路接通:
+ * attach → 首屏快照 → prompt → 流式增量 → 结束。DispatchSession 另外六十多个
+ * 方法目前是**按接口签名自动生成的空实现** —— 由 server/index.ts 里导出的
+ * `DispatchSession` 接口逐条对出来的, 所以漏掉一个 TypeScript 当场报错,
+ * 不会等到用户点了才抛。
+ *
+ * 目的只有一个: 让一段**真实的 Claude Code / Codex 对话**在 pi-web-ui 的界面里
+ * 跑出来, 看一眼观感对不对, 再决定要不要补完剩下的。
+ *
+ * 与 dsh 引擎的关键差别 (见 docs/dsh-engine.md):
+ *   · dsh 换模型要重启运行时 (model 在 initialize 就固定了);
+ *     claude/codex 是**按次指定** (`--model` / `-m`), 所以这里换模型不重启。
+ *   · dsh 要另搭 973 行 JSON-RPC 运行时壳; 这两个 CLI 直接 spawn 就有 JSON。
+ */
+
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import type { DispatchSession, TerminalManagerLike } from "../index.js";
+import type {
+	CommandDef,
+	PromptAttachment,
+	ServerMessage,
+	UiContentBlock,
+	UiMessage,
+	UiState,
+	UiSubagentTemplate,
+} from "../protocol.js";
+import { SPECS, type CliSpec, type CliEvent } from "./cli-adapter.js";
+import { DEFAULT_MODEL, childEnv, listCatalog, writeCodexConfig } from "./gateway.js";
+import {
+	claudeProjectDir,
+	listClaudeSessions,
+	listCodexSessions,
+	replayClaudeSession,
+	replayCodexSession,
+	searchSessions,
+} from "./sessions.js";
+import { FilesService } from "../files-service.js";
+import { BgServerTracker } from "../bg-servers.js";
+import { existsSync, rmSync, statSync } from "node:fs";
