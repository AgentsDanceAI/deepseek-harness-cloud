index 0000000..dfbfb59
--- /dev/null
+++ b/server/cli/sessions.ts
@@ -0,0 +1,212 @@
+/**
+ * sessions.ts —— 从 CLI 自己的会话存储里读历史（列表 + 回放）。
+ *
+ * 两个 CLI 的目录布局与行格式都是**实测出来的**, 不是照文档写的:
+ *   claude  ~/.claude/projects/<cwd 的 / 与 . 换成 ->/<sessionId>.jsonl
+ *           行里 type=user / assistant, 正文在 message.content 的 block 数组里;
+ *           中间夹着 queue-operation / attachment / file-history-snapshot /
+ *           last-prompt 这些内部行, 一律跳过。
+ *   codex   ~/.codex/sessions/<年>/<月>/<日>/rollout-<时间>-<id>.jsonl
+ *           第一行 type=session_meta, payload 里有 cwd 与 id —— **按 cwd 筛项目
+ *           只能靠它**, 因为目录是按日期分的, 跟项目没有对应关系。
+ *
+ * **我们不另建一套会话存储。** CLI 自己就是事实来源 —— 另存一份的话, 用户在
+ * 终端里直接敲 claude/codex 产生的会话在网页上看不见, 而两边指的是同一个目录。
+ */
+
+import { existsSync, readdirSync, readFileSync, realpathSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { SessionSummary, UiMessage } from "../protocol.js";
+
+/** 读前 N 字节就够: 标题在最前面, 而会话文件可以几十 MB。 */
+const HEAD_BYTES = 65536;
+/** 回放的上限。一个跑了一天的会话能有几千条, 全塞给前端只会把页面卡死;
+ *  取最后 N 条 —— 人回到一个会话时看的是尾巴, 不是开头。 */
+const REPLAY_MAX = 200;
+
+export function claudeProjectDir(cwd: string): string {
+	// **必须先 realpath。** macOS 上 /tmp 是指向 /private/tmp 的软链: claude 按
+	// 进程真实 cwd 建目录 (`-private-tmp-x`), 而传进来的是 /tmp/x, 算出来是
+	// `-tmp-x` —— 目录不存在, 列表**永远空且不报错**。踩过一次。
+	let real = cwd;
+	try {
+		real = realpathSync(cwd);
+	} catch {
+		/* 目录没了就按原样算, 下面 existsSync 还会兜一层 */
+	}
+	return join(homedir(), ".claude", "projects", real.replace(/[/.]/g, "-"));
+}
+
+function readLines(file: string, bytes?: number): string[] {
+	try {
+		const raw = readFileSync(file, "utf8");
+		return (bytes ? raw.slice(0, bytes) : raw).split("\n").filter((l) => l.trim());
+	} catch {
+		return [];
+	}
+}
+
+function parse(line: string): Record<string, any> | null {
+	try {
+		return JSON.parse(line) as Record<string, any>;
+	} catch {
+		return null;                       // 半行 / 非 JSON —— 一行坏数据不该毁掉整个列表
+	}
+}
+
+/** block 数组 → 纯文本, 用于列表上那行标题。 */
+function blocksText(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	return content
+		.filter((c: any) => c?.type === "text" && typeof c.text === "string")
+		.map((c: any) => c.text)
+		.join("")
+		.trim();
+}
+
+// --- claude ----------------------------------------------------------------
+
+function claudeSummary(file: string, id: string, modified: number): SessionSummary {
+	let first = "";
+	let count = 0;
+	for (const line of readLines(file, HEAD_BYTES)) {
+		const e = parse(line);
+		if (!e) continue;
+		if (e.type !== "user" && e.type !== "assistant") continue;
+		count++;
+		if (!first && e.type === "user") first = blocksText(e.message?.content).slice(0, 120);
+	}
+	return { path: id, firstMessage: first || "(无标题)", messageCount: count, modified, source: "tui" };
+}
+
+export function listClaudeSessions(cwd: string): SessionSummary[] {
+	const dir = claudeProjectDir(cwd);
+	if (!existsSync(dir)) return [];
+	const out: SessionSummary[] = [];
+	for (const name of readdirSync(dir)) {
+		if (!name.endsWith(".jsonl")) continue;
+		const file = join(dir, name);
+		try {
+			out.push(claudeSummary(file, name.replace(/\.jsonl$/, ""), statSync(file).mtimeMs));
+		} catch {
+			/* 读不到就跳过这一个, 别让整张列表消失 */
+		}
+	}
+	return out.sort((a, b) => b.modified - a.modified);
+}
+
+// --- codex -----------------------------------------------------------------
+
+/** codex 的会话按日期摊开存, 跟 cwd 没有对应关系 —— 只能逐个读第一行的
+ *  session_meta.payload.cwd 来认。为此**只读第一行**, 不整文件读。 */
+function codexFiles(): string[] {
+	const root = join(homedir(), ".codex", "sessions");
+	if (!existsSync(root)) return [];
+	const out: string[] = [];
+	const walk = (dir: string, depth: number): void => {
+		if (depth > 4) return;                 // 年/月/日/文件, 再深就不是它的布局了
+		let names: string[] = [];
+		try {
+			names = readdirSync(dir);
+		} catch {
+			return;
+		}
+		for (const n of names) {
+			const p = join(dir, n);
+			try {
+				if (statSync(p).isDirectory()) walk(p, depth + 1);
+				else if (n.endsWith(".jsonl")) out.push(p);
+			} catch {
+				/* 跳过 */
+			}
+		}
+	};
+	walk(root, 0);
+	return out;
+}
+
+export function listCodexSessions(cwd: string): SessionSummary[] {
+	let real = cwd;
+	try {
+		real = realpathSync(cwd);
+	} catch {
+		/* 同上 */
+	}
+	const out: SessionSummary[] = [];
+	for (const file of codexFiles()) {
+		const head = readLines(file, HEAD_BYTES);
+		const meta = head.length ? parse(head[0]!) : null;
+		if (meta?.type !== "session_meta") continue;
+		const payload = meta.payload ?? {};
+		if (payload.cwd !== real && payload.cwd !== cwd) continue;   // 不是这个项目的
+		const id = String(payload.id ?? "");
+		if (!id) continue;
+		let first = "";
+		let count = 0;
+		for (const line of head.slice(1)) {
+			const e = parse(line);
+			if (!e) continue;
+			// response_item 里带 role 的那种才是对话; 其余是内部记账。
+			const item = e.payload ?? e;
+			const role = item?.role ?? item?.message?.role;
+			if (role !== "user" && role !== "assistant") continue;
+			count++;
+			if (!first && role === "user") first = blocksText(item.content ?? item.message?.content).slice(0, 120);
+		}
+		let modified = 0;
+		try {
+			modified = statSync(file).mtimeMs;
+		} catch {
+			continue;
+		}
+		out.push({ path: id, firstMessage: first || "(无标题)", messageCount: count, modified, source: "tui" });
+	}
+	return out.sort((a, b) => b.modified - a.modified);
+}
+
+// --- 回放 -------------------------------------------------------------------
+
+/** 把 claude 的 JSONL 翻成界面上的消息。
+ *
+ * 只认 type=user / assistant 两种行 —— 中间夹着的 queue-operation、attachment、
+ * file-history-snapshot、last-prompt 都是 CLI 的内部记账, 翻出来是噪音。
+ * 工具调用块暂时按文本摘要给: 真正渲染成工具卡片要连 toolResult 一起配对,
+ * 那是另一摊 (dsh 引擎为此写了 301 行的 dsh-serialize.ts)。
+ */
+export function replayClaudeSession(cwd: string, sessionId: string): UiMessage[] {
+	const file = join(claudeProjectDir(cwd), `${sessionId}.jsonl`);
+	if (!existsSync(file)) return [];
+	const msgs: UiMessage[] = [];
+	let seq = 0;
+	for (const line of readLines(file)) {
+		const e = parse(line);
+		if (!e || (e.type !== "user" && e.type !== "assistant")) continue;
+		const content = e.message?.content;
+		const blocks: UiMessage["content"] = [];
+		if (typeof content === "string") {
+			if (content.trim()) blocks.push({ type: "text", text: content });
+		} else if (Array.isArray(content)) {
+			for (const c of content as any[]) {
+				if (c?.type === "text" && typeof c.text === "string" && c.text.trim()) {
+					blocks.push({ type: "text", text: c.text });
+				} else if (c?.type === "thinking" && typeof c.thinking === "string") {
+					blocks.push({ type: "thinking", text: c.thinking });
+				} else if (c?.type === "tool_use") {
+					blocks.push({ type: "text", text: `[工具] ${String(c.name ?? "")}` });
+				}
+			}
+		}
+		if (!blocks.length) continue;
+		const ts = Date.parse(e.timestamp ?? "") || Date.now();
+		msgs.push({
+			id: `${e.type === "user" ? "u" : "a"}-replay-${seq++}`,
+			role: e.type,
+			content: blocks,
+			timestamp: ts,
+		});
+	}
+	// 取尾巴: 人回到一个会话时看的是最近发生了什么。
+	return msgs.length > REPLAY_MAX ? msgs.slice(-REPLAY_MAX) : msgs;
+}
