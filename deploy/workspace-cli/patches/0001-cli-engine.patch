+++ b/server/cli/gateway.ts
@@ -0,0 +1,150 @@
+/**
+ * gateway.ts —— 接 AI Store 的模型网关。
+ *
+ * 这是「免 Key」那条铁律在这个引擎里的落点: 用户不自购任何 API Key, 密钥托管在
+ * 服务端, CLI 通过我们的网关调模型, 按积分计费。所以:
+ *   · 给子进程注入的是**网关地址 + 该用户的工作台令牌**, 不是厂商密钥;
+ *   · 型号列表来自网关的在售目录 —— 网关只放行目录里的型号, 前端列别的等于
+ *     给用户一个点了就 404 的选项。
+ *
+ * 两个 env 与 AI Store 其它工作台同名 (见 dhc 仓 products.py env_for):
+ *   DSH_GATEWAY_BASE  站点根, 例如 https://aistore.best
+ *   DSH_CLOUD_TOKEN   该用户该实例的工作台令牌 (每次建实例都会换)
+ * 没配就退回"用 CLI 自己的登录态", 本机开发照样能跑。
+ */
+
+import { mkdirSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+import type { ModelInfo } from "../protocol.js";
+
+export const GATEWAY_BASE = (process.env.DSH_GATEWAY_BASE ?? "").replace(/\/+$/, "");
+export const GATEWAY_TOKEN = process.env.DSH_CLOUD_TOKEN ?? "";
+export const gatewayConfigured = (): boolean => Boolean(GATEWAY_BASE && GATEWAY_TOKEN);
+
+/**
+ * 子进程要带的环境变量。
+ *
+ * claude 走 anthropic 面, codex 走 responses 面 —— 两条路的 base_url 不一样,
+ * 这在 AI Store 侧已经踩清楚了 (codex 0.151 起不认 chat 面, 只能 responses)。
+ *
+ * **ANTHROPIC_SMALL_FAST_MODEL 必须一起给**: 不设的话 claude 的后台任务会去要
+ * haiku, 而网关只放行在售目录, 那个名字不在里面 —— 症状是主对话正常、后台
+ * 静默 404。
+ */
+export function childEnv(cli: "claude" | "codex", model: string): NodeJS.ProcessEnv {
+	const env: NodeJS.ProcessEnv = { ...process.env };
+	if (!gatewayConfigured()) return env;
+	if (cli === "claude") {
+		env.ANTHROPIC_BASE_URL = `${GATEWAY_BASE}/llm/anthropic`;
+		env.ANTHROPIC_AUTH_TOKEN = GATEWAY_TOKEN;
+		if (model) {
+			env.ANTHROPIC_MODEL = model;
+			env.ANTHROPIC_SMALL_FAST_MODEL = model;
+		}
+		// 有 ANTHROPIC_API_KEY 时 CLI 会优先用它 —— 那是用户自己的厂商密钥,
+		// 会绕过我们的计费。托管环境里一律不带。
+		delete env.ANTHROPIC_API_KEY;
+	} else {
+		// codex 的 base_url / wire_api 在 ~/.codex/config.toml 里 (见 writeCodexConfig),
+		// 这里只给密钥 —— config.toml 的 env_key 指的就是它。
+		env.OPENAI_API_KEY = GATEWAY_TOKEN;
+	}
+	return env;
+}
+
+/** 在售目录 → 前端的型号列表。拉不到就返回空, 不抛 —— 网关抖一下不该让整个
+ *  界面变成错误页 (同 AI Store 自研工作台的 credits 那条口径)。 */
+export async function listCatalog(): Promise<ModelInfo[]> {
+	if (!gatewayConfigured()) return [];
+	try {
+		const r = await fetch(`${GATEWAY_BASE}/llm/v1/models`, {
+			headers: { authorization: `Bearer ${GATEWAY_TOKEN}` },
+		});
+		if (!r.ok) return [];
+		const body = (await r.json()) as { data?: Array<Record<string, unknown>> };
+		return (body.data ?? []).map((m) => ({
+			id: String(m.id ?? ""),
+			name: String(m.display_name ?? m.id ?? ""),
+			provider: "AI Store",
+			// 能力口径跟着网关走; 缺字段时按"支持"算 —— 列出来点了不行, 好过
+			// 有能力却不给选。真实能力在 AI Store 侧的 model_capabilities.json,
+			// 那份是实测出来的。
+			reasoning: m.reasoning !== false,
+			vision: m.vision === true,
+		})).filter((m) => m.id);
+	} catch {
+		return [];
+	}
+}
+
+/** codex 的 config.toml。**每次开机重写**: 里面有该用户的网关令牌, 而令牌每次
+ *  建实例都会换, 沿用旧的必然 401。 */
+export function codexConfigToml(model: string): string {
+	return [
+		`model = "${model}"`,
+		'model_provider = "aistore"',
+		"",
+		"[model_providers.aistore]",
+		'name = "AI Store"',
+		`base_url = "${GATEWAY_BASE}/llm/v1"`,
+		'env_key = "OPENAI_API_KEY"',
+		// codex 0.151 起不认 chat 面, 只能 responses。
+		'wire_api = "responses"',
+		"",
+	].join("\n");
+}
+
+/** 两格各自的默认型号。
+ *
+ * **不取在售目录的第一个** —— 那是 deepseek-v4-flash, 实测走 anthropic 面对短
+ * 提示返回空内容, 界面一直转 (见 cli-session.listModels 那段)。与 AI Store 产品
+ * 侧一致 (dhc 仓 products.py 的 _codecli_model)。
+ */
+export const DEFAULT_MODEL: Record<"claude" | "codex", string> = {
+	claude: "claude-sonnet-5",
+	codex: "gpt-5.6-luna",
+};
+
+/**
+ * [终端] 页里那两个 CLI 的网关接线。
+ *
+ * 引擎的子进程走 childEnv(); **终端是另一条路** —— 用户在终端敲 `claude`,
+ * 那是 node-pty 起的 shell, 继承的是服务进程的 env, 而服务进程的 env 里只有
+ * DSH_GATEWAY_BASE / DSH_CLOUD_TOKEN 两个 (dhc 仓 products.py 的 env_for 故意
+ * 只给这两个: 接线由这里一处说了算)。于是同一个界面上, 对话是通的、终端里
+ * `claude` 张口就是 `Not logged in · Please run /login` —— 一半登录了一半没有。
+ *
+ * **两个 CLI 的都给**: 这一格默认哪个引擎, 不该限制用户在终端里敲哪个。
+ */
+export function terminalEnv(base: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+	if (!gatewayConfigured()) return base;
+	const env: NodeJS.ProcessEnv = { ...base };
+	env.ANTHROPIC_BASE_URL = `${GATEWAY_BASE}/llm/anthropic`;
+	env.ANTHROPIC_AUTH_TOKEN = GATEWAY_TOKEN;
+	env.ANTHROPIC_MODEL = DEFAULT_MODEL.claude;
+	env.ANTHROPIC_SMALL_FAST_MODEL = DEFAULT_MODEL.claude;
+	// 同 childEnv: 有它时 CLI 优先用它, 那是用户自己的厂商密钥, 会绕过计费。
+	delete env.ANTHROPIC_API_KEY;
+	env.OPENAI_API_KEY = GATEWAY_TOKEN;
+	return env;
+}
+
+/**
+ * 把 codex 的 config.toml 写到位。
+ *
+ * codex 的 base_url / wire_api 给不了 env, 只能从 config.toml 读。两处要写:
+ * 开机一次 (**终端里的 codex 在用户打开对话面板之前就该能用**), 以及每轮对话
+ * 前一次 (型号是按次可换的, config 里钉着当前那个)。
+ */
+export function writeCodexConfig(model: string = DEFAULT_MODEL.codex): void {
+	if (!gatewayConfigured()) return;
+	try {
+		const dir = join(homedir(), ".codex");
+		mkdirSync(dir, { recursive: true });
+		writeFileSync(join(dir, "config.toml"), codexConfigToml(model), "utf8");
+	} catch (e) {
+		console.error("[codex] 写 config.toml 失败:", e);
+	}
+}
