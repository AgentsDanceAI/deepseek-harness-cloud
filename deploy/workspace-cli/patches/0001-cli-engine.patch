@@ -0,0 +1,159 @@
+/**
+ * cli-adapter.ts —— 把 CLI 的 JSON 行归一成同一套事件。
+ *
+ * 这一层是**从 AI Store 的自研工作台移植过来的** (deploy/workspace-agentui/
+ * app/adapters.py)。那边的注释写着"每个 schema 都是实测抓出来的, 不是照文档
+ * 写的" —— 所以这里照抄形状, 不重新猜。
+ *
+ * 与 dsh 引擎的区别: DSH 的 SDK 是个库, 要另搭一个 JSON-RPC 运行时壳
+ * (server/dsh/runtime/, 973 行); claude 与 codex 本来就往 stdout 吐 JSON,
+ * 直接 spawn 就行。
+ */
+
+export type CliEvent =
+	| { t: "session"; id: string }
+	| { t: "delta"; text: string }
+	| { t: "text"; text: string }
+	| { t: "thinking"; text: string }
+	| { t: "tool"; id: string; name: string; input: unknown }
+	| { t: "tool_end"; id: string; ok: boolean; output: string }
+	| { t: "done"; usage: { input: number; output: number; cacheRead: number } }
+	| { t: "error"; message: string }
+	| { t: "raw"; line: string };
+
+export interface CliSpec {
+	readonly id: "claude" | "codex";
+	readonly name: string;
+	/** 起一轮对话的 argv。resume 为空表示新会话。 */
+	argv(prompt: string, resume: string | null, model: string): string[];
+	/** prompt 走 stdin 还是 argv。 */
+	readonly stdinPrompt: boolean;
+	stdinPayload(prompt: string): string | null;
+	feed(line: string): CliEvent[];
+}
+
+const num = (v: unknown): number => (typeof v === "number" ? v : 0);
+
+/** Claude Code: 双向 stream-json, 三个里最完整的一个。 */
+export const claudeSpec: CliSpec = {
+	id: "claude",
+	name: "Claude Code",
+	stdinPrompt: true,
+	argv(_prompt, resume, model) {
+		const a = [
+			"--print",
+			"--input-format", "stream-json",
+			"--output-format", "stream-json",
+			"--include-partial-messages",
+			"--verbose",
+			"--dangerously-skip-permissions",
+		];
+		if (model) a.push("--model", model);
+		if (resume) a.push("--resume", resume);
+		return a;
+	},
+	stdinPayload(prompt) {
+		return (
+			JSON.stringify({
+				type: "user",
+				message: { role: "user", content: [{ type: "text", text: prompt }] },
+			}) + "\n"
+		);
+	},
+	feed(line) {
+		let e: Record<string, any>;
+		try {
+			e = JSON.parse(line);
+		} catch {
+			return [{ t: "raw", line }];
+		}
+		if (e.type === "system" && e.subtype === "init") return [{ t: "session", id: String(e.session_id ?? "") }];
+		if (e.type === "stream_event") {
+			const ev = e.event ?? {};
+			const d = ev.delta;
+			if (d?.type === "text_delta") return [{ t: "delta", text: String(d.text ?? "") }];
+			if (d?.type === "thinking_delta") return [{ t: "thinking", text: String(d.thinking ?? "") }];
+			// 工具调用: content_block_start 带 tool_use。**必须出事件** —— 一轮里
+			// 如果全是工具活动 (模型先派 Explore 子智能体再回答), 界面上一个字都
+			// 不动, 看着就是卡死。实测踩过: 真模型问"读一下 fib.py", 它先起子
+			// 智能体探索, 界面停在「正在思考」二十多秒, 其实一直在干活。
+			const cb = ev.content_block;
+			if (ev.type === "content_block_start" && cb?.type === "tool_use") {
+				return [{ t: "tool", id: String(cb.id ?? ""), name: String(cb.name ?? "?"), input: cb.input }];
+			}
+			return [];
+		}
+		// **不收 type=\"assistant\" 的整段正文**: 开着 --include-partial-messages 时
+		// 它与 text_delta 是同一份内容的两种给法, 两个都收正文会翻倍。
+		// 实测 (走 AI Store 网关): claude-sonnet-5 两边都是「你好世界」;
+		// gpt-5.6-luna 的 assistant 行甚至是「你好世界你好世界」(分两条给)。
+		if (e.type === "result") {
+			const u = e.usage ?? {};
+			return [
+				{
+					t: "done",
+					usage: {
+						input: num(u.input_tokens),
+						output: num(u.output_tokens),
+						cacheRead: num(u.cache_read_input_tokens),
+					},
+				},
+			];
+		}
+		return [{ t: "raw", line }];
+	},
+};
+
+/** Codex: `codex exec --json`, 单向 JSONL。**没有流式增量** —— 正文是一整段
+ *  item.completed 给的, 所以走 "text" 而不是 "delta"。 */
+export const codexSpec: CliSpec = {
+	id: "codex",
+	name: "Codex",
+	stdinPrompt: false,
+	argv(prompt, resume, model) {
+		const a = ["exec", "--json", "--skip-git-repo-check", "--sandbox", "danger-full-access"];
+		if (model) a.push("-m", model);          // 按次指定 —— dsh 引擎做不到这点
+		if (resume) a.push("resume", resume);
+		a.push(prompt);
+		return a;
+	},
+	stdinPayload() {
+		return null;
+	},
+	feed(line) {
+		let e: Record<string, any>;
+		try {
+			e = JSON.parse(line);
+		} catch {
+			return [{ t: "raw", line }];
+		}
+		if (e.type === "thread.started") return [{ t: "session", id: String(e.thread_id ?? "") }];
+		if (e.type === "item.completed") {
+			const it = e.item ?? {};
+			if (it.type === "agent_message") return [{ t: "text", text: String(it.text ?? "") }];
+			if (it.type === "reasoning") return [{ t: "thinking", text: String(it.text ?? "") }];
+			if (["command_execution", "file_change", "tool_call"].includes(it.type)) {
+				return [{ t: "tool", id: String(it.id ?? ""), name: String(it.type), input: it }];
+			}
+		}
+		if (e.type === "turn.completed") {
+			const u = e.usage ?? {};
+			return [
+				{
+					t: "done",
+					usage: {
+						input: num(u.input_tokens),
+						output: num(u.output_tokens),
+						cacheRead: num(u.cached_input_tokens),
+					},
+				},
+			];
+		}
+		if (e.type === "turn.failed" || e.type === "error") {
+			return [{ t: "error", message: JSON.stringify(e).slice(0, 400) }];
+		}
+		return [{ t: "raw", line }];
+	},
+};
+
+export const SPECS: Record<string, CliSpec> = { claude: claudeSpec, codex: codexSpec };
