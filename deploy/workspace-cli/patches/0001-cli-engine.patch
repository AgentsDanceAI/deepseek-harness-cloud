+/** 工具输出的上限。一条 `find /` 能有几 MB —— 整条塞给前端只会把页面卡住,
+ *  而人要看的是头几十行。截断标记交给前端渲染 (UiTextBlock.truncated)。 */
+const TOOL_OUTPUT_CAP = 20000;
+
+function capOutput(raw: string): { text: string; truncated: boolean } {
+	return raw.length > TOOL_OUTPUT_CAP
+		? { text: raw.slice(0, TOOL_OUTPUT_CAP), truncated: true }
+		: { text: raw, truncated: false };
+}
+
+/** 工具参数转成卡片上显示的那段文本。对象就序列化, 字符串原样。 */
+function argsText(input: unknown): string {
+	if (input === undefined || input === null) return "";
+	if (typeof input === "string") return input;
+	try {
+		const s = JSON.stringify(input);
+		return s === "{}" ? "" : s;
+	} catch {
+		return "";
+	}
+}
+
+type Send = (msg: ServerMessage) => void;
+
+export class CliSession implements DispatchSession {
+	cwd: string;
+	private readonly spec: CliSpec;
+	private readonly send: Send;
+	private readonly clientId: string;
+	private child: ChildProcessWithoutNullStreams | null = null;
+	private resume: string | null = null;
+	private model = "";
+	private messages: UiMessage[] = [];
+	private streaming: UiMessage | null = null;
+	private rev = 0;
+	private seq = 0;
+	private conversationId = randomUUID();
+	private usage = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };
+	// 文件树 / 预览 / 补全 / SCM 与终端**都不是引擎的事** —— 它们是工作区的事。
+	// 所以直接用项目自己的实现 (server/files-service.ts / server/terminals.ts),
+	// dsh 引擎也是这么接的; 各写一份必然漂, 而且这两块和 agent 无关。
+	private readonly files: FilesService;
+	private readonly terminals: TerminalManager;
+	/** 本轮已经建过卡片的工具 (toolCallId -> 那个块)。参数是流式补上去的, 而
+	 *  codex 的 started/completed 两条都带同一个 id —— 靠它去重。 */
+	private toolBlocks = new Map<string, { argumentsText?: string }>();
+	/** 后台服务列表。复用上游那个自包含模块 (server/bg-servers.ts) —— 它只依赖
+	 *  端口快照, 不关心是谁跑的命令, 所以我们这条"CLI 自己跑 bash"的路也能用。
+	 *  **粒度是每轮一次**, 不是每条 bash 命令一次: 我们看不见 CLI 内部的命令边界,
+	 *  只看得见一轮的开始与结束。要的语义("这一轮之后它留下了什么常驻服务")是对的。 */
+	private readonly bg = new BgServerTracker({
+		emit: (msg) => this.send(msg),
+		flushSnapshot: () => this.snapshot(),
+		isDisposed: () => this.disposed,
+	});
+	/** 当前思考档位。默认值与 CLI 自己的默认对得上 (见 cli-adapter)。 */
+	private thinking = "";
+	/** 本轮 CLI 自己报过的最后一条错。没有正文时拿它当结论。 */
+	private lastError: string | null = null;
+	/** 这一轮是用户自己按停的。**按停不是故障** —— 别给他报一条"退出码 143"。 */
+	private aborted = false;
+	private disposed = false;
+	private lang = "en";
+
+	constructor(clientId: string, cwd: string, engine: string, send: Send) {
+		this.clientId = clientId;
+		this.cwd = cwd;
+		this.send = send;
+		const spec = SPECS[engine];
+		if (!spec) throw new Error(`unknown CLI engine: ${engine}`);
+		this.spec = spec;
+		this.thinking = spec.defaultThinking;
+		this.files = new FilesService({
+			emit: (msg) => this.send(msg),
+			isDisposed: () => this.disposed,
+			getCwd: () => this.cwd,
+			getActiveCwd: () => this.cwd,
+		});
+		this.terminals = new TerminalManager((msg) => this.send(msg), cwd, () => "en");
+	}
+
+	// ---- 真逻辑 ---------------------------------------------------------
+
+	/** 首屏快照。UiState 四十个字段, 骨架只填对话需要的那些, 其余给空。 */
+	snapshot(): void {
+		this.send({ type: "snapshot", state: this.state() });
+	}
+
+	private state(): UiState {
+		return {
+			clientId: this.clientId,
+			cwd: this.cwd,
+			sessionId: this.resume ?? "",
+			conversationId: this.conversationId,
+			rev: ++this.rev,
+			messages: this.messages,
+			streamingMessage: this.streaming,
+			isStreaming: this.child !== null,
+			model: this.model ? { id: this.model, name: this.model, provider: this.spec.name, vision: false } : null,
+			thinkingLevel: this.thinking,
+			availableThinkingLevels: [...this.spec.thinkingLevels],
+			queue: { steering: [], followUp: [] },
+			tools: [],
+			version: 0,
+			piConfigured: true,
+			piAgentInstalled: true,
+			stats: {
+				totalMessages: this.messages.length,
+				tokens: { ...this.usage, total: this.usage.input + this.usage.output },
+				cost: 0,
+				contextUsage: { tokens: null, contextWindow: 128000, percent: null },
+			},
+		};
+	}
+
+	async prompt(text: string, _attachments?: unknown[], _queue?: boolean): Promise<void> {
+		if (this.child) return;                       // 骨架: 一次一轮, 不排队
+		this.aborted = false;
+		this.messages.push({
+			id: `u-${Date.now()}-${this.seq++}`,
+			role: "user",
+			content: [{ type: "text", text }],
+			timestamp: Date.now(),
+		});
+		this.toolBlocks.clear();
+		this.streaming = { id: `a-${Date.now()}-${this.seq++}`, role: "assistant", content: [], timestamp: Date.now() };
+		this.snapshot();
+
+		const argv = this.spec.argv(text, this.resume, this.model, this.thinking);
+		// codex 的 base_url/wire_api 只能从 config.toml 读, 给不了 env —— 每轮
+		// 重写一次, 因为型号是按次可换的, 而 config 里钉着当前这个。
+		// (开机时也写过一次, 为的是终端里的 codex —— 见 gateway.writeCodexConfig。)
+		// 型号还没定过时 (前端只在打开面板时才发 list_models) **别写空的进去** ——
+		// config.toml 里 `model = ""` 会让 codex 回落到它自己的内置默认, 而那个
+		// 名字不在我们的在售目录里, 网关只会回 404。
+		if (this.spec.id === "codex") writeCodexConfig(this.model || DEFAULT_MODEL.codex);
+		// 这一轮开始前拍一次监听端口 —— 跑完再拍一次, 差集就是它留下的后台服务。
+		this.bg.snapshotBefore();
+		const child = spawn(this.spec.id, argv, { cwd: this.cwd, env: childEnv(this.spec.id, this.model) });
+		this.child = child;
+		if (this.spec.stdinPrompt) {
+			const payload = this.spec.stdinPayload(text);
+			if (payload) child.stdin.write(payload);
+		}
+		// **stdin 一定要关**, 不管这一轮的 prompt 走 stdin 还是走 argv。
+		// codex 的 exec 开头一句就是 `Reading additional input from stdin...` ——
+		// 不给它 EOF 它就一直等: 界面上"正在思考"转到天荒地老, 一个字节的输出
+		// 都没有, 进程也不退, 日志里同样什么都没有。2026-09-11 老板实拍到的就是
+		// 这个。原来只在 stdinPrompt 那条分支里关, 于是只有 claude 那格是对的。
+		child.stdin.end();
+
+		let buf = "";
+		child.stdout.on("data", (chunk: Buffer) => {
+			buf += chunk.toString("utf8");
+			let nl: number;
+			while ((nl = buf.indexOf("\n")) >= 0) {
+				const line = buf.slice(0, nl).trim();
+				buf = buf.slice(nl + 1);
+				if (line) for (const ev of this.spec.feed(line)) this.onEvent(ev);
+			}
+		});
+		// stderr 不丢: CLI 起不来时 (没装 / 没登录) 这里是唯一线索。
+		child.stderr.on("data", (c: Buffer) => console.error(`[${this.spec.id}]`, c.toString("utf8").trim()));
+		await new Promise<void>((done) => {
+			child.on("close", (code) => {
+				this.child = null;
+				if (this.streaming && this.streaming.content.length) this.messages.push(this.streaming);
+				else if (!this.aborted) {
+					// **一个字都没出的那一轮也得留下话。** 原来只在退出码非零时才
+					// 报, 而"退出码 0 + 零输出"是真实存在的一类 (型号走不通那条面
+					// 时就这样) —— 用户看到转圈停了、页面上什么也没多出来。
+					this.messages.push({
+						id: `a-${Date.now()}-${this.seq++}`, role: "assistant", content: [],
+						errorMessage: this.lastError ?? (code === 0
+							? `${this.spec.name} 本轮没有任何输出`
+							: `${this.spec.name} 退出码 ${code}`),
+						timestamp: Date.now(),
+					});
+				}
+				this.lastError = null;
+				this.streaming = null;
+				this.snapshot();
+				void this.bg.trackAfterBash();        // 这一轮留下的常驻服务
+				done();
+			});
+			child.on("error", (e) => {
+				this.child = null; this.streaming = null;
+				this.messages.push({
+					id: `a-${Date.now()}-${this.seq++}`, role: "assistant", content: [],
+					errorMessage: `起不来 ${this.spec.id}: ${e.message}`, timestamp: Date.now(),
+				});
+				this.snapshot(); done();
+			});
+		});
+	}
+
+	private onEvent(ev: CliEvent): void {
+		if (ev.t === "session") { this.resume = ev.id; return; }
+		if (ev.t === "delta" || ev.t === "text") {
+			if (!this.streaming) return;
+			const last = this.streaming.content[this.streaming.content.length - 1] as { type: string; text?: string } | undefined;
+			if (last && last.type === "text") last.text = (last.text ?? "") + ev.text;
+			else this.streaming.content.push({ type: "text", text: ev.text });
+			// **别用 as never 糊过去。** 第一版就是这么写的 (只带 text), 而真实帧要
+			// messageId / usage / assistantMessageEvent —— 前端读 .assistantMessageEvent.type
+			// 时拿到 undefined, 整页白屏。绕开编译器的那一处, 正好就是炸的那一处。
+			this.send({
+				type: "message_delta",
+				conversationId: this.conversationId,
+				seq: this.seq++,
+				messageId: this.streaming.id,
+				usage: null,
+				assistantMessageEvent: { type: "text_delta", contentIndex: this.streaming.content.length - 1, delta: ev.text },
+			});
+			return;
+		}
+		if (ev.t === "thinking") {
+			// **思考也要出。** 适配层一直在产生这个事件 (claude 的 thinking_delta /
+			// codex 的 reasoning), 而 onEvent 里**根本没有这个分支** —— 事件生成出来
+			// 就没人要, 界面上"思考: 高"设了也永远看不到思考内容 (老板 2026-09-12 实拍)。
+			//
+			// 块的字段名是 `thinking` 不是 `text` (protocol.ts 的 UiThinkingBlock),
+			// 增量帧的类型是 `thinking_delta` —— 前端按这两样认 (web/src/message-delta.ts),
+			// 写错任何一个都是"有块但空白"。
+			if (!this.streaming) return;
+			const tail = this.streaming.content[this.streaming.content.length - 1] as
+				| { type: string; thinking?: string }
+				| undefined;
+			if (tail && tail.type === "thinking") tail.thinking = (tail.thinking ?? "") + ev.text;
+			else this.streaming.content.push({ type: "thinking", thinking: ev.text } as UiContentBlock);
+			this.send({
+				type: "message_delta",
+				conversationId: this.conversationId,
+				seq: this.seq++,
+				messageId: this.streaming.id,
+				usage: null,
+				assistantMessageEvent: {
+					type: "thinking_delta",
+					contentIndex: this.streaming.content.length - 1,
+					delta: ev.text,
+				},
+			});
+			return;
+		}
+		if (ev.t === "tool") {
+			// 真正的工具卡片: 助手消息里放一个 toolCall 块, 结果另起一条
+			// role="toolResult" 的消息按 toolCallId 配对 (前端就是这么认的,
+			// 见 web/src/use-chat.ts 里 `m.role === "toolResult" && m.toolCallId`)。
+			// **一轮里全是工具活动是常态** (模型先派子智能体再回答), 卡片一出来
+			// 用户才看得见它在干什么 —— 原来只给一行 `[工具] X`, 干了二十秒也只有
+			// 那一行, 看着像卡死。
+			if (!this.streaming) return;
+			if (this.toolBlocks.has(ev.id)) return;   // started + completed 都来时只建一次
+			const block = {
+				type: "toolCall",
+				id: ev.id,
+				name: ev.name,
+				argumentsText: argsText(ev.input),
+			} as UiContentBlock;
+			this.streaming.content.push(block);
+			this.toolBlocks.set(ev.id, block as { argumentsText?: string });
+			this.snapshot();
+			return;
+		}
+		if (ev.t === "tool_args") {
+			// claude 的参数是 input_json_delta 一片片给的, 贴到对应那张卡片上。
+			const b = this.toolBlocks.get(ev.id);
+			if (!b) return;
+			b.argumentsText = (b.argumentsText ?? "") + ev.delta;
+			this.send({
+				type: "tool_delta",
+				conversationId: this.conversationId,
+				seq: this.seq++,
+				toolCallId: ev.id,
+				toolName: "",
+				delta: ev.delta,
+			});
+			return;
+		}
+		if (ev.t === "tool_end") {
+			// 结果单独成一条消息 —— 与 dsh 引擎同一个形状 (dsh-serialize.ts)。
+			// 截断在服务端做: 一条 `find /` 的输出能有几 MB, 整条塞给前端只会把
+			// 页面卡住, 而用户要看的是头几十行。
+			const { text, truncated } = capOutput(ev.output);
+			this.messages.push({
+				id: `t-${ev.id}`,
+				role: "toolResult",
+				content: [{ type: "text", text, truncated }],
+				toolCallId: ev.id,
+				isError: !ev.ok,
+				timestamp: Date.now(),
+			});
+			// 这一帧让界面立刻从"运行中"翻成"done", 不用等下一次快照。
+			this.send({ type: "tool_status", toolCallId: ev.id, toolName: "", isError: !ev.ok });
+			this.snapshot();
+			return;
+		}
+		if (ev.t === "error") {
+			// CLI 自己报的错 (codex 的 turn.failed, 以及 item 里 type=error 的那种)。
+			// 原来这个分支**根本不存在** —— 事件生成出来就被丢掉了, 症状是"什么
+			// 都没发生"。立刻弹给用户; 同时记下来, 这一轮最终没有正文时拿它当结论。
+			this.lastError = ev.message;
+			this.emitNotice("error", `${this.spec.name}: ${ev.message}`, `${this.spec.name}: ${ev.message}`);
+			return;
+		}
+		if (ev.t === "done") {
+			this.usage.input += ev.usage.input;
+			this.usage.output += ev.usage.output;
+			this.usage.cacheRead += ev.usage.cacheRead;
+		}
+	}
+
+	async abort(): Promise<void> {
+		this.aborted = true;
+		this.child?.kill("SIGTERM");
+		this.child = null;
+		this.streaming = null;
+		this.snapshot();
+	}
+
+	async newChat(): Promise<void> {
+		this.resume = null;
+		this.messages = [];
+		this.streaming = null;
+		this.conversationId = randomUUID();
+		this.snapshot();
+	}
+
+	/** 型号列表。骨架先给一个 —— 真接的时候从 AI Store 网关的在售目录灌进来
+	 *  (products.py 的 _pi_boot 已经在给 pi 那一格这么做了)。 */
+	async listModels(): Promise<void> {
+		const models = await listCatalog();
+		// 没配网关时列表是空的 —— 那说明这是本机开发, CLI 用它自己的登录态, 型号
+		// 由 CLI 自己定, 我们不该假装能选。
+		//
+		// **默认型号按槽位钉死, 不取目录第一个。** 目录第一个是 deepseek-v4-flash,
+		// 实测它走 anthropic 面对短提示返回**空内容** (message_start → message_delta
+		// (end_turn) → message_stop, 没有任何 content_block_delta), CLI 于是自己补
+		// 一句"你上轮没有可见输出"再试一次, 还是空 —— 用户看到的是界面一直转。
+		// 这两个默认值与 AI Store 产品侧一致 (products.py 的 _codecli_model)。
+		const preferred = DEFAULT_MODEL[this.spec.id];
+		if (models.length && !this.model) {
+			this.model = models.some((m) => m.id === preferred) ? preferred : models[0]!.id;
+		}
+		this.send({ type: "models", models });
+		this.snapshot();
+	}
+
+	async setModel(modelId: string): Promise<void> {
+		// 按次指定, 不重启任何东西 —— dsh 引擎在这点上要重启运行时。
+		this.model = modelId;
+		this.snapshot();
+	}
+
+	// ---- 以下为按接口自动生成的空实现 (其余) ---- ---------------------------
+	// ---- 以下这批**故意保持空实现**, 不是没做完 ------------------------
+	//
+	// 判据只有一条: **这个引擎里它没有对应的东西**, 不是"以后再说"。
+	// 会话/终端/文件/Git/模型这些有对应物的, 都已经接上了 (见上面)。
+	//
+	// 供应商密钥 / 型号配置 (setProviderApiKey · addProviderKey · saveModelConfig
