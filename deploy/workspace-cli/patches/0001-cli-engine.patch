+	// 等于绕过网关也绕过计费, 而界面上看不出任何异常。
+	// 型号列表由 listModels 从网关在售目录拉 (见 gateway.ts), 不由用户配。
+	//
+	// installPiAgent / checkUpdate / dsh 补丁: 托管环境里升级是我们重建镜像的事,
+	// 不是用户点一下的事 (同 products.py 给 pi 那格设 PI_OFFLINE 的理由)。
+	//
+	// 目标/审查 (setGoal · startGoalWizard …): dsh 引擎也没做 (docs/dsh-engine.md
+	// 里列在"简化实现"那栏)。它依赖 agent 侧的多轮自审, claude/codex 的 CLI 面
+	// 给不了这个语义 —— 硬做出来只能是个假的。
+
+
+	removeQueued(_kind: "steer" | "followUp", _text: string): void {  }
+	/** 终端里跑着的东西由 TerminalManager 管, 中止就是杀它。 */
+	async abortBash(): Promise<void> {
+		await this.abort();
+	}
+	/** 重试上一条 —— 错误卡上那个「重试」按钮走这里。把最后一条用户消息连同它
+	 *  之后的助手回复一起丢掉再重发, 否则重试一次列表里就多一份重复的提问。 */
+	async retryLast(): Promise<void> {
+		const i = this.messages.map((m) => m.role).lastIndexOf("user");
+		if (i < 0) return;
+		const text = (this.messages[i]!.content[0] as { text?: string } | undefined)?.text ?? "";
+		this.messages = this.messages.slice(0, i);
+		if (text) await this.prompt(text);
+	}
+	async killBackgroundServer(port?: number, _taskId?: string): Promise<boolean> {
+		// taskId 那条是插件注册的常驻任务, 我们这条路没有插件 —— 只按端口杀。
+		return port === undefined ? false : await this.bg.killOne(port);
+	}
+	async killAllBackgroundServers(): Promise<string[]> { return await this.bg.killAll(); }
+	async listBgServers(): Promise<void> { await this.bg.listAndPush(); }
+	/** 改掉一条已发的提问再重问。
+	 *
+	 *  **那条之后的全部要一起丢掉** —— 包括它自己的回复和后面每一轮。否则界面上会
+	 *  留着"针对旧问题的回答", 而 CLI 侧的上下文里也还留着它, 越问越不对。
+	 *  同 retryLast 的口径 (它丢的是最后一条之后)。
+	 *  改完必然是新话题: 断开 resume, 让 CLI 起一轮新的, 别把旧上下文带进来。 */
+	async editMessage(messageId: string, text: string, _attachments?: PromptAttachment[]): Promise<void> {
+		if (this.child) return;                       // 一次一轮, 正在跑就不动
+		const i = this.messages.findIndex((m) => m.id === messageId);
+		if (i < 0 || !text.trim()) return;
+		this.messages = this.messages.slice(0, i);
+		this.resume = null;
+		await this.prompt(text);
+	}
+	/** 在在售目录里轮换到下一个型号。快捷键走这里, 与下拉选择是同一个状态。 */
+	async cycleModel(): Promise<void> {
+		const models = await listCatalog();
+		if (!models.length) return;
+		const i = models.findIndex((m) => m.id === this.model);
+		await this.setModel(models[(i + 1) % models.length]!.id);
+	}
+	/** 快捷键轮换到下一档 —— 与下拉选择是同一个状态 (同 cycleModel)。 */
+	cycleThinking(): void {
+		const ls = this.spec.thinkingLevels;
+		const i = ls.indexOf(this.thinking);
+		this.setThinking(ls[(i + 1) % ls.length]!);
+	}
+	flushSnapshot(_forceFull?: boolean): void {
+		this.snapshot();
+	}
+	async pushSlashCommands(): Promise<void> {  }
+	async refreshSessions(): Promise<void> {
+		// codex 的会话按日期摊开存, 跟 cwd 没有对应关系 —— 靠逐个读第一行的
+		// session_meta.payload.cwd 认项目 (见 sessions.ts)。
+		const sessions = this.spec.id === "claude" ? listClaudeSessions(this.cwd) : listCodexSessions(this.cwd);
+		this.send({ type: "sessions", sessions });
+	}
+	async pushProjects(): Promise<void> {  }
+	async removeProject(_path: string): Promise<void> {  }
+	/** 删的是 CLI 自己的会话文件 —— 那是唯一一份, 删了终端里也看不到了。
+	 *  只删当前引擎目录下的那一个, 且路径由 sessionId 拼出来, 不接受外部传入的
+	 *  绝对路径 (那是任意文件删除)。 */
+	async deleteSession(path: string): Promise<void> {
+		if (this.spec.id !== "claude" || !/^[\w-]+$/.test(path)) return;
+		try {
+			rmSync(join(claudeProjectDir(this.cwd), `${path}.jsonl`), { force: true });
+		} catch (e) {
+			this.emitNotice("error", `删除会话失败：${String(e)}`, `Failed to delete session: ${String(e)}`);
+		}
+		await this.refreshSessions();
+	}
+	async renameSession(_path: string, _name: string): Promise<void> {  }
+	async renameConversation(_id: string, _name: string): Promise<void> {  }
+	async dismissConversation(_id: string, _withFinishedSubagents?: boolean, _force?: boolean): Promise<void> {  }
+	async dismissFinishedSubagents(_parentId?: string): Promise<void> {  }
+	async switchSession(path: string): Promise<void> {
+		// path 就是 sessionId —— 直接喂给下一轮的 --resume, 同时把历史翻出来
+		// 铺到界面上 (replayClaudeSession)。不回放的话界面从空白开始, 而 CLI 那边
+		// 其实记得上下文 —— 用户看到的是"它把刚才说的忘了", 实际没忘, 更糊涂。
+		this.resume = path;
+		this.streaming = null;
+		this.conversationId = randomUUID();
+		this.messages =
+			this.spec.id === "claude" ? replayClaudeSession(this.cwd, path) : replayCodexSession(this.cwd, path);
+		if (!this.messages.length) {
+			// 回放不出东西时要说清楚"界面空不等于上下文丢了" —— CLI 那边 --resume
+			// 拿到的仍是完整会话。(会话文件被清过、或只有工具调用没有正文时会这样。)
+			this.emitNotice("info", "已接上这个会话，上下文在 CLI 侧保留", "Resumed; context is kept on the CLI side");
+		}
+		this.snapshot();
+	}
+	/** 切到另一个会话 —— 与左栏点一条历史是同一件事, 复用同一段逻辑。 */
+	async switchConversation(id: string): Promise<void> {
+		await this.switchSession(id);
+	}
+	async listFiles(path?: string): Promise<void> { await this.files.listFiles(path); }
+	async searchFiles(query: string, reqId: number): Promise<void> { await this.files.searchFiles(query, reqId); }
+	/** 全局搜索面板里的"会话内容"那一栏。扫的是 CLI 自己的会话文件。 */
+	async searchSessions(query: string, reqId: number): Promise<void> {
+		try {
+			const results = searchSessions(this.spec.id, this.cwd, query);
+			this.send({ type: "session_search_results", reqId, query, ok: true, results });
+		} catch {
+			// ok:false 的约定是"扫失败, 当没结果" —— 别让一个坏文件把搜索框打成错误页。
+			this.send({ type: "session_search_results", reqId, query, ok: false, results: [] });
+		}
+	}
+	async readFile(path: string): Promise<void> { await this.files.readFile(path); }
+	async writeFile(path: string, text: string): Promise<void> { await this.files.writeFile(path, text); }
+	async uploadFile(dirPath: string, name: string, data: string): Promise<void> { await this.files.uploadFile(dirPath, name, data); }
+	/** 思考档位。**只收这个 CLI 真能给的那几档** —— 界面里也只会列出这几档
+	 *  (见 cli-adapter 的 thinkingLevels)。收到不认识的就忽略, 不假装设上了。 */
+	setThinking(level: string): void {
+		if (!this.spec.thinkingLevels.includes(level)) return;
+		this.thinking = level;
+		this.snapshot();
+	}
+	async setCwd(path: string): Promise<void> {
+		const abs = resolve(path);
+		if (!existsSync(abs) || !statSync(abs).isDirectory()) {
+			this.emitNotice("error", `切换工作目录失败：目录不存在：${path}`, `Cannot switch: no such directory: ${path}`);
+			return;
+		}
+		this.cwd = abs;
+		// 换了项目就等于换了上下文 —— 续聊 id 必须丢掉, 否则下一轮会拿着上一个
+		// 项目的会话接着聊, 而界面上显示的是新项目。
+		this.resume = null;
+		await this.listFiles(undefined);
+		this.snapshot();
+	}
+	async completePath(path: string): Promise<void> { await this.files.completePath(path); }
+	async makeDir(path: string): Promise<void> { await this.files.makeDir(path); }
+	async checkUpdate(): Promise<void> {  }
