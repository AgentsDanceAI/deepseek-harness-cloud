+/**
+ * cli-agent-service.ts —— 第三个引擎的连接管理器 (PI_WEB_ENGINE=claude|codex)。
+ *
+ * EngineService 只有十六个必需方法, 它管的是**连接**, 不是会话本身 ——
+ * 真正的面在 attach() 返回的 DispatchSession 上 (见 cli-session.ts)。
+ *
+ * 骨架阶段: 每个 clientId 一个会话, 不做静默期 (quiesce) 的排队语义 ——
+ * 那是给"服务端要重启但别掐断用户"用的, 等这条路确定要走再补。
+ */
+
+import type { EngineService } from "../index.js";
+import type { ServerMessage } from "../protocol.js";
+import { CliSession } from "./cli-session.js";
+
+export class CliAgentService implements EngineService {
+	private readonly clients = new Map<string, CliSession>();
+	private sockets = 0;
+	private quiesced = false;
+	private quiescedSince: number | undefined;
+
+	constructor(
+		private readonly cwd: string,
+		private readonly engine: string,
+		private readonly version: string,
+	) {}
+
+	async attach(clientId: string, send: (msg: ServerMessage) => void): Promise<CliSession> {
+		let cs = this.clients.get(clientId);
+		if (!cs) {
+			cs = new CliSession(clientId, this.cwd, this.engine, send);
+			this.clients.set(clientId, cs);
+		}
+		// 首屏: 先把快照推过去, 否则前端停在空白等状态。
+		cs.snapshot();
+		// **型号要在第一轮对话之前就定下来。** 前端是等面板打开才发 list_models 的,
+		// 而用户完全可能一上来就发消息 —— 那时 this.model 还是空, 等于没给 --model,
+		// 于是落到 CLI 自己的默认型号, 而网关只放行在售目录, 结果是一发就 404。
+		// 拉目录是异步的, 不挡 attach; 拉完会自己再推一次快照。
+		void cs.listModels();
+		return cs;
+	}
+
+	detach(clientId: string, _send: (msg: ServerMessage) => void): void {
+		this.clients.delete(clientId);
+	}
+
+	get(clientId: string): CliSession | undefined {
+		return this.clients.get(clientId);
+	}
+
+	async disposeAll(): Promise<void> {
+		for (const cs of this.clients.values()) await cs.abort();
+		this.clients.clear();
+	}
+
+	noteSocketOpen(): void { this.sockets++; }
+	noteSocketClose(): void { this.sockets = Math.max(0, this.sockets - 1); }
+	isQuiesced(): boolean { return this.quiesced; }
+	quiesce(): void { this.quiesced = true; this.quiescedSince = Date.now(); }
+	unquiesce(): void { this.quiesced = false; this.quiescedSince = undefined; }
+	quiesceInfo(): { quiesced: boolean; quiescedSince?: number } {
+		return this.quiescedSince === undefined
+			? { quiesced: this.quiesced }
+			: { quiesced: this.quiesced, quiescedSince: this.quiescedSince };
+	}
+
+	serviceStatus() {
+		return {
+			pid: process.pid,
+			version: this.version,
+			cwd: this.cwd,
+			quiesced: this.quiesced,
+			...(this.quiescedSince === undefined ? {} : { quiescedSince: this.quiescedSince }),
+			connectedClients: this.sockets,
+			activeConversations: this.activeConversations(),
+			pendingMessages: 0,
+		};
+	}
+
+	activeConversations(): number { return this.clients.size; }
+	pendingMessages(): number { return 0; }
+	applyPluginAgentTools(): void {}
+	applyPluginCommandCatalog(): void {}
+	refreshBackgroundServers(): void {}
+	async setLocale(_clientId: string, _locale: string): Promise<void> {}
+}
