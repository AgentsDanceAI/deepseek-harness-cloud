<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Electron hardened runtime 最低 entitlements (公证硬性要求, docs/code-signing.md 报告二§三):
     allow-jit 为 V8 JIT 必需; allow-unsigned-executable-memory 兼容旧路径, 加上无害。
     SIGN_MODE=devid 时由 build_macos_dmg.sh 应用到主程序与全部 Helper。 -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Desktop automation requires child-process execution and Apple Events.
       These capabilities remain subject to macOS user consent. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
