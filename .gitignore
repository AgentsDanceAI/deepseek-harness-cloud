__pycache__/
*.pyc
.venv*/
server/data/
desktop/build/
node_modules/
.pytest_cache/
*.egg-info/

# secrets — never commit
deploy/**/.env
# Any sidecar of it too. A timestamped backup holds the same gateway keys,
# payment private key and database password as the original, and `git add -A`
# would have swept one straight into the repo.
.env.*
!.env.example
.env
!deploy/**/.env.template
!deploy/**/.env.example

# electron-builder downloads ~150MB of Electron/NSIS/winCodeSign per build;
# build-win.sh keeps it here so rebuilds are fast, but it is a cache, not source.
desktop/.cache-electron/

# stray build cache from a desktop build run
.gradle-cache/

# deploy/workspace-opendesign/build.sh 打出来的 profile bundle / runtime tarball,
# 是构建产物不是源码。固定名 open-design-dsh-runtime.tgz, npm pack 的带版本变体
# 也一并挡掉, 免得 git add -A 把它扫进仓库 (CLAUDE.md 记过整文件误带上线的事故)。
deploy/workspace-opendesign/open-design-dsh-runtime*.tgz

# macOS 目录元数据, 从来不该进仓库
.DS_Store
