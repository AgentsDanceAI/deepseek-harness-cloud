__pycache__/
*.pyc
.venv*/
server/data/
desktop/build/
node_modules/
.pytest_cache/
*.egg-info/

# secrets — never commit
deploy/**/.env
# Any sidecar of it too. A timestamped backup holds the same gateway keys,
# payment private key and database password as the original, and `git add -A`
# would have swept one straight into the repo.
.env.*
!.env.example
.env
!deploy/**/.env.template
!deploy/**/.env.example

# electron-builder downloads ~150MB of Electron/NSIS/winCodeSign per build;
# build-win.sh keeps it here so rebuilds are fast, but it is a cache, not source.
desktop/.cache-electron/
